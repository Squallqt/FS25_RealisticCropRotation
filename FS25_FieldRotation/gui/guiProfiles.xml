    <Profile name="frPlanSlotYear" extends="fs25_textDefault" with="anchorTopCenter">
        <position value="0px -9px"/>
        <size value="210px 18px"/>
        <textSize value="12px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Crop icon — below year label, above selector (filename set in Lua) -->
    <Profile name="frPlanSlotCropIcon" extends="baseReference" with="anchorTopCenter">
        <position value="0px -31px"/>
        <size value="44px 44px"/>
    </Profile>

    <!-- Crop cycle selector — MultiTextOption positioned below icon (wrap enabled) -->
    <Profile name="frPlanSlotSelector" extends="fs25_multiTextOption" with="anchorTopCenter">
        <size value="200px 34px"/>
        <position value="0px -82px"/>
        <wrap value="true"/>
    </Profile>

    <!-- Family badge at bottom of plan slot (slightly wider than history badge) -->
    <Profile name="frPlanSlotBadgeBg" extends="baseReference" with="anchorBottomCenter">
        <position value="0px 8px"/>
        <size value="100px 22px"/>
        <color value="$preset_fs25_colorGrey"/>
        <cornerSize value="0.20"/>
    </Profile>

    <Profile name="frPlanSlotBadgeText" extends="fs25_textDefault" with="anchorBottomCenter">
        <position value="0px 8px"/>
        <size value="100px 22px"/>
        <textSize value="12px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_fs25_colorMainDark"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
