    <Profile name="frLimeValueLabel" extends="frNitrogenValueLabel">
        <textColor value="$preset_fs25_colorGreen"/>
    </Profile>

    <Profile name="frLimeFill" extends="frNitrogenTrack">
        <color value="$preset_fs25_colorGreen"/>
    </Profile>

