    <!-- ============================================================ -->
    <!--  YIELD CARD (1240 x 82 px)                                    -->
    <!-- ============================================================ -->

    <Profile name="frYieldCard" extends="emptyPanel" with="anchorTopLeft">
        <size value="1240px 82px"/>
    </Profile>

    <Profile name="frYieldCardBg" extends="baseReference" with="anchorTopLeft">
        <size value="1240px 82px"/>
        <color value="0 0 0 0.50"/>
        <cornerSize value="0.35"/>
    </Profile>

    <Profile name="frYieldAccent" extends="fs25_lineSeparatorTopHighlighted" with="anchorTopLeft">
