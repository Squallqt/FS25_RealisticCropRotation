        <position value="24px -6px"/>
        <size value="300px 18px"/>
        <textSize value="12px"/>
        <textBold value="true"/>
        <textUpperCase value="false"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <Profile name="frLimeStateLabel" extends="frNitrogenStateLabel">
        <textUpperCase value="false"/>
    </Profile>

    <!-- Crop need note: centered above the nitrogen gauge.
