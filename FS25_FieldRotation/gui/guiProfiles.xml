    <!-- Field name — line 1 -->
    <Profile name="frSidebarItemName" extends="fs25_subCategoryListItemName">
        <width value="108px"/>
        <position value="94px -18px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Area in ha — line 1, right-aligned (x offset from right sourced from OSE profiles) -->
    <Profile name="frSidebarItemArea" extends="fs25_subCategoryListItemName" with="anchorTopRight">
        <width value="84px"/>
        <position value="-46px -18px"/>
        <textSize value="15px"/>
        <textBold value="true"/>
        <textAlignment value="right"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <!-- Crop · Family — line 2 -->
    <Profile name="frSidebarItemCropLine" extends="fs25_subCategoryListItemName">
        <width value="238px"/>
        <position value="94px -46px"/>
        <textSize value="12px"/>
        <textBold value="false"/>
        <textUpperCase value="false"/>
        <textColor value="$preset_colorWhite_50"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <!-- ============================================================ -->
    <!--  DETAIL CONTAINER                                             -->
    <!-- ============================================================ -->

    <Profile name="frDetailContainer" extends="baseReference" with="anchorTopLeft">
