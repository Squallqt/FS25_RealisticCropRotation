    <!-- ============================================================ -->
    <!--  TIMELINE STRIP                                               -->
    <!--                                                               -->
    <!--  5 slot cards (224 px) + 4 arrow gaps (25 px) = 1220 px      -->
    <!--  plus 8 px left margin = 1228 px inside 1240 px container     -->
    <!--  Slot height: 148 px. No global rail: each card owns its bg.   -->
    <!--                                                               -->
    <!--  Gradient de présence N-4 (faint) → N-1 (ancré) :            -->
    <!--  frSlotCardBgN4 0.22 / N3 0.32 / N2 0.44 / N1 0.58           -->
    <!--  Conseil 0.16 (ghosté)                                        -->
    <!-- ============================================================ -->

    <Profile name="frTimeline" extends="emptyPanel" with="anchorTopLeft">
        <size value="1240px 154px"/>
    </Profile>

    <!-- Slot card container (224 x 148 px) -->
    <Profile name="frSlotCard" extends="emptyPanel" with="anchorTopLeft">
        <size value="224px 148px"/>
    </Profile>

    <!-- Base shape shared by all slot backgrounds -->
    <Profile name="frSlotCardBg" extends="baseReference" with="anchorTopLeft">
        <size value="224px 148px"/>
        <color value="0 0 0 0.44"/>
        <cornerSize value="0.35"/>
    </Profile>

    <!-- N-4: oldest season — most faded -->
    <Profile name="frSlotCardBgN4" extends="frSlotCardBg">
        <color value="0 0 0 0.22"/>
    </Profile>

    <!-- N-3 -->
    <Profile name="frSlotCardBgN3" extends="frSlotCardBg">
        <color value="0 0 0 0.32"/>
    </Profile>

    <!-- N-2 -->
    <Profile name="frSlotCardBgN2" extends="frSlotCardBg">
        <color value="0 0 0 0.44"/>
    </Profile>

    <!-- N-1: most recent, most prominent + green accent line -->
    <Profile name="frSlotCardBgN1" extends="frSlotCardBg">
        <color value="0 0 0 0.58"/>
    </Profile>

    <!-- Conseil slot: ghosted future -->
    <Profile name="frSlotCardBgFuture" extends="frSlotCardBg">
        <color value="0 0 0 0.16"/>
    </Profile>

    <!-- Green accent line at top of N-1 slot -->
    <Profile name="frSlotAccentN1" extends="fs25_lineSeparatorTopHighlighted" with="anchorTopLeft">
        <size value="224px 3dp"/>
        <position value="0px 0px"/>
        <imageColor value="$preset_fs25_colorGreen"/>
    </Profile>

    <!-- Season label — top of card -->
    <Profile name="frSlotSeasonLabel" extends="fs25_textDefault" with="anchorTopCenter">
        <position value="0px -9px"/>
        <size value="210px 18px"/>
        <textSize value="12px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Crop icon — center of card (filename loaded in Lua) -->
    <Profile name="frSlotIcon" extends="baseReference" with="anchorTopCenter">
        <position value="0px -32px"/>
        <size value="52px 52px"/>
    </Profile>

    <!-- Crop name — below icon -->
    <Profile name="frSlotCropName" extends="fs25_textDefault" with="anchorTopCenter">
        <position value="0px -92px"/>
        <size value="210px 18px"/>
        <textSize value="14px"/>
        <textBold value="false"/>
        <textUpperCase value="false"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Family badge background pill — bottom of card (color set in Lua) -->
    <Profile name="frSlotFamilyBadgeBg" extends="baseReference" with="anchorBottomCenter">
        <position value="0px 8px"/>
        <size value="88px 22px"/>
        <color value="$preset_fs25_colorGrey"/>
        <cornerSize value="0.20"/>
    </Profile>

    <!-- Family badge text overlay -->
    <Profile name="frSlotFamilyBadgeText" extends="fs25_textDefault" with="anchorBottomCenter">
        <position value="0px 8px"/>
        <size value="88px 22px"/>
        <textSize value="12px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_fs25_colorMainDark"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Thin connector between slots: horizontal line + arrow text -->
    <Profile name="frTimelineConnectorLine" extends="baseReference" with="anchorMiddleLeft">
        <position value="0px 0px"/>
        <size value="25px 2px"/>
        <color value="$preset_fs25_colorMainHighlight"/>
        <cornerSize value="0.20"/>
    </Profile>

    <Profile name="frTimelineArrowText" extends="fs25_textDefault" with="anchorBottomCenter">
        <position value="0px 18px"/>
        <size value="25px 18px"/>
        <textSize value="12px"/>
        <textBold value="false"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
    </Profile>

    <!-- Container for the connector assembly -->
