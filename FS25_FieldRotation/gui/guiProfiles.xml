<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>

    <!-- ============================================================ -->
    <!--  SIDEBAR                                                      -->
    <!-- ============================================================ -->

    <Profile name="frSidebarList" extends="emptyPanel"/>

    <!-- ============================================================ -->
    <!--  SIDEBAR CELL                                               -->
    <!--    Line 1 y=-18: field name bold 16px | area right         -->
    <!--    Line 2 y=-46: crop · family  muted 12px                 -->
