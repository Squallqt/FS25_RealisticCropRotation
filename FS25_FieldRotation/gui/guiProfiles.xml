        <textVerticalAlignment value="middle"/>
        <textMaxNumLines value="1"/>
        <textUpperCase value="false"/>
    </Profile>

    <Profile name="frYieldKpiValueNA" extends="frYieldKpiValue">
        <textColor value="$preset_fs25_colorGrey"/>
    </Profile>

    <!-- Thin vertical divider between the two KPIs -->
    <Profile name="frYieldDivider" extends="baseReference" with="anchorTopCenter">
        <position value="0px -18px"/>
