    <!-- Plan timeline strip — 4 history-sized slots spread across 1240 px -->
    <Profile name="frPlanTimeline" extends="emptyPanel" with="anchorTopLeft">
        <size value="1240px 154px"/>
    </Profile>

    <!-- Individual plan slot card: same footprint as the history timeline cards -->
