<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="FieldRotationFrame">

    <!-- ============================ LEFT SIDEBAR ============================ -->
    <ThreePartBitmap profile="fs25_primaryMenuContainerBg">
        <Bitmap profile="fs25_menuContainerArrow"/>

        <GuiElement profile="fs25_subCategoryContainer">

            <!-- View tab selector: cycles ASSOLEMENT <-> PLANIFICATION -->
            <MultiTextOption profile="fs25_subCategorySelector" id="viewSelector" onClick="onViewChanged"/>

            <BoxLayout profile="fs25_subCategorySelectorBox" id="viewSelectorDotBox">
                <RoundCorner profile="fs25_subCategorySelectorDot"/>
                <RoundCorner profile="fs25_subCategorySelectorDot"/>
            </BoxLayout>

            <GuiElement profile="fs25_subCategoryListContainer">
                <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
                <Bitmap profile="fs25_subCategoryStopClipper"  name="endClipper"/>

                <SmoothList profile="frSidebarList" id="listFields"
                    startClipperElementName="startClipper"
                    endClipperElementName="endClipper"
                    handleFocus="true"
                    listItemSpacing="-20px">

                    <ListItem profile="fs25_subCategoryListItem" name="field">
                        <Bitmap profile="fs25_subCategoryListItemIcon" name="cropIcon"  visible="false"/>
                        <Text   profile="frSidebarItemName"            name="fieldName" text="-"/>
                        <Text   profile="frSidebarItemArea"            name="fieldArea" text=""/>
                        <Text   profile="frSidebarItemCropLine"        name="cropLine"  text=""/>
                    </ListItem>

                    <ListItem profile="fs25_subCategoryListItemEmpty" name="empty"/>
                </SmoothList>

                <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="listFields"/>
                </ThreePartBitmap>
            </GuiElement>

        </GuiElement>
    </ThreePartBitmap>

    <!-- ============================ RIGHT PANE ============================ -->
    <GuiElement profile="fs25_menuContentContainer">

        <GuiElement profile="fs25_menuHeaderPanel" position="0px 74px">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="fieldRotation.menuIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="menuHeaderTitle" text="$l10n_fieldRotation_menu_title"/>
        </GuiElement>

        <!-- ===================== DETAIL CONTAINER ===================== -->
        <!--                                                              -->
        <!--  Balanced layout — leaves room for the FS25 bottom help bar: -->
        <!--    Hero           y=   0  h= 88                             -->
        <!--    Section HIST   y= -98  h= 32                             -->
        <!--    Timeline       y=-144  h=154   gap title/card = 14       -->
        <!--    Section N      y=-330  h= 32   group gap = 32            -->
        <!--    N gauge        y=-374  h= 54   gap title/card = 12       -->
        <!--    Section LIME   y=-452  h= 32   group gap = 24            -->
        <!--    Lime / pH      y=-496  h= 54                             -->
        <!--    Section ADVICE y=-574  h= 32                             -->
        <!--    Advice         y=-618  h= 64                             -->
        <!--    Section YIELD  y=-706  h= 32                             -->
        <!--    Yield          y=-750  h= 82                             -->
        <!--    Total: 832 px                                             -->
        <!-- ============================================================ -->
        <GuiElement profile="frDetailContainer" id="detailsContainer">

            <!-- == HERO CARD (y=0..88) == -->
            <GuiElement profile="frHeroCard" position="20px 0px">
                <RoundCorner     profile="frHeroCardBg"/>
                <ThreePartBitmap profile="frHeroAccent"/>
                <Text profile="frHeroTitle" id="detailTitle"  text="-"/>
                <Text profile="frHeroMeta"  id="detailSeason" text=""/>
                <RoundCorner profile="frStatusPillBg"   id="statusPillBg"/>
                <Text        profile="frStatusPillText" id="statusPillText" text=""/>
            </GuiElement>

            <!-- == SECTION: CROP HISTORY (y=-98) == -->
            <GuiElement profile="frSectionBar" position="0px -98px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_fr_section_history"/>
            </GuiElement>

            <!-- == TIMELINE STRIP (y=-144..298) == -->
            <!--                                                               -->
            <!--  Slot x-positions (w=224, connector gap=25):                 -->
            <!--    Slot1 x=8   Conn x=232  Slot2 x=257  Conn x=481           -->
            <!--    Slot3 x=506 Conn x=730  Slot4 x=755  Conn x=979           -->
            <!--    Slot5 x=1004                                               -->
            <!-- ============================================================ -->
            <GuiElement profile="frTimeline" position="20px -144px">
                <!-- == Slot 1: N-4 == -->
                <GuiElement profile="frSlotCard" position="8px -4px">
                    <RoundCorner profile="frSlotCardBgN4"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot1SeasonLabel" text="$l10n_fr_slot_n4"/>
                    <Bitmap      profile="frSlotIcon"            id="slot1Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot1CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot1BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot1BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 1 -->
                <GuiElement profile="frHistoryTimelineConnector" position="232px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 2: N-3 == -->
                <GuiElement profile="frSlotCard" position="257px -4px">
                    <RoundCorner profile="frSlotCardBgN3"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot2SeasonLabel" text="$l10n_fr_slot_n3"/>
                    <Bitmap      profile="frSlotIcon"            id="slot2Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot2CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot2BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot2BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 2 -->
                <GuiElement profile="frHistoryTimelineConnector" position="481px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 3: N-2 == -->
                <GuiElement profile="frSlotCard" position="506px -4px">
                    <RoundCorner profile="frSlotCardBgN2"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot3SeasonLabel" text="$l10n_fr_slot_n2"/>
                    <Bitmap      profile="frSlotIcon"            id="slot3Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot3CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot3BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot3BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 3 -->
                <GuiElement profile="frHistoryTimelineConnector" position="730px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 4: N-1 == -->
                <GuiElement profile="frSlotCard" position="755px -4px">
                    <RoundCorner     profile="frSlotCardBgN1"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot4SeasonLabel" text="$l10n_fr_slot_n1"/>
                    <Bitmap      profile="frSlotIcon"            id="slot4Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot4CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot4BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot4BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 4 -->
                <GuiElement profile="frHistoryTimelineConnector" position="979px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 5: CURRENT active crop / ground state == -->
                <GuiElement profile="frSlotCard" position="1004px -4px">
                    <RoundCorner profile="frSlotCardBgCurrent"/>
                    <ThreePartBitmap profile="frSlotAccentCurrent"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot5SeasonLabel" text="$l10n_fr_slot_current"/>
                    <Bitmap      profile="frSlotIcon"            id="slot5Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot5CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot5BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot5BadgeText"   text="" visible="false"/>
                </GuiElement>

            </GuiElement>

            <!-- == SECTION: NITROGEN STATUS (y=-330) == -->
            <GuiElement profile="frSectionBar" position="0px -330px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentN" position="14px 0px"/>
                <Text profile="frSectionTitleN" text="$l10n_fr_section_nitrogen"/>
            </GuiElement>

            <!-- == NITROGEN GAUGE CARD (y=-374..428) == -->
            <GuiElement profile="frNitrogenCard" position="20px -374px">
                <RoundCorner profile="frNitrogenCardBg"/>
                <Text        profile="frNitrogenStateLabel" id="nitrogenStateLabel" text=""/>
                <Text        profile="frNitrogenValueLabel" id="nitrogenValueLabel" text="" visible="false"/>
                <RoundCorner profile="frNitrogenTrack"/>
                <RoundCorner profile="frNitrogenFill"      id="nitrogenBarFill"    visible="false"/>
            </GuiElement>

            <!-- == SECTION: LIME / PH STATUS (y=-452) == -->
            <GuiElement profile="frSectionBar" position="0px -452px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentN" position="14px 0px"/>
                <Text profile="frSectionTitleN" text="$l10n_fr_section_lime"/>
            </GuiElement>

            <!-- == LIME / PH GAUGE CARD (y=-496..550) == -->
            <GuiElement profile="frNitrogenCard" position="20px -496px">
                <RoundCorner profile="frNitrogenCardBg"/>
                <Text        profile="frLimeStateLabel"     id="limeStateLabel" text=""/>
                <Text        profile="frLimeValueLabel"     id="limeValueLabel" text="" visible="false"/>
                <RoundCorner profile="frNitrogenTrack"/>
                <RoundCorner profile="frLimeFill"           id="limeBarFill"    visible="false"/>
            </GuiElement>

            <!-- == SECTION: AGRONOMIC ADVICE (y=-574) == -->
            <GuiElement profile="frSectionBar" position="0px -574px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentAdvice" position="14px 0px"/>
                <Text profile="frSectionTitleAdvice" text="$l10n_fr_section_advice"/>
            </GuiElement>

            <!-- == ADVICE CARD (y=-618..682) == -->
            <GuiElement profile="frAdviceCard" position="20px -618px">
                <RoundCorner     profile="frAdviceCardBg"/>
                <ThreePartBitmap profile="frAdviceAccent"/>
                <Text            profile="frAdviceText" id="adviceText" text=""/>
            </GuiElement>

            <!-- == SECTION: YIELD STATUS (y=-706) == -->
            <GuiElement profile="frSectionBar" position="0px -706px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentYield" position="14px 0px"/>
                <Text profile="frSectionTitleYield" text="$l10n_fr_section_yield"/>
            </GuiElement>

            <!-- == YIELD CARD (y=-750..832) == -->
            <GuiElement profile="frYieldCard" position="20px -750px">
                <RoundCorner     profile="frYieldCardBg"/>
                <ThreePartBitmap profile="frYieldAccent"/>

                <GuiElement profile="frYieldKpi" position="0px 0px">
                    <Text profile="frYieldKpiLabel" text="$l10n_fr_yield_harvest"/>
                    <Text profile="frYieldKpiValueNA" id="yieldTotalValue" text="-"/>
                </GuiElement>

                <RoundCorner profile="frYieldDivider" position="-207px -18px"/>

                <GuiElement profile="frYieldKpi" position="413px 0px">
                    <Text profile="frYieldKpiLabel" text="$l10n_fr_yield_weed"/>
                    <Text profile="frYieldKpiValueNA" id="yieldPerHaValue" text="-"/>
                </GuiElement>

                <RoundCorner profile="frYieldDivider" position="207px -18px"/>

                <GuiElement profile="frYieldKpi" position="827px 0px">
                    <Text profile="frYieldKpiLabel" text="$l10n_fr_yield_stage"/>
                    <Text profile="frYieldKpiValueNA" id="yieldStageValue" text="-"/>
                </GuiElement>
            </GuiElement>

        </GuiElement>

        <!-- ===================== PLANNING CONTAINER (tab 2) ===================== -->
        <!--                                                                        -->
        <!--  Layout — same y-origin as detailsContainer (y=0 = top of card):      -->
        <!--    Hero           y=   0  h= 88                                        -->
        <!--    Section PLAN   y= -98  h= 32                                        -->
        <!--    Plan slots     y=-144  h=154   gap title/card = 14                  -->
        <!--    Section SCORE  y=-330  h= 32   group gap = 32                       -->
        <!--    Score card     y=-374  h= 80   gap title/card = 12                  -->
        <!--    Section GLOBAL y=-476  h= 32   group gap = 32                       -->
        <!--    Overview       y=-520  h=270   gap title/card = 12                  -->
        <!--    Total: 790 px                                                        -->
        <!-- =================================================================== -->
        <GuiElement profile="frPlanContainer" id="planningContainer" visible="false">

            <!-- == HERO CARD (y=0..88) == -->
            <GuiElement profile="frHeroCard" position="20px 0px">
                <RoundCorner     profile="frHeroCardBg"/>
                <ThreePartBitmap profile="frHeroAccent"/>
                <Text profile="frHeroTitle" id="planTitle"  text="-"/>
                <Text profile="frHeroMeta"  id="planSeason" text=""/>
                <RoundCorner profile="frStatusPillBg"   id="planStatusPillBg"/>
                <Text        profile="frStatusPillText" id="planStatusPillText" text=""/>
            </GuiElement>

            <!-- == SECTION: PLAN DE ROTATION (y=-98) == -->
            <GuiElement profile="frSectionBar" position="0px -98px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_fr_section_plan"/>
            </GuiElement>

            <!-- == PLAN TIMELINE (y=-144..298) == -->
            <!--                                                                        -->
            <!--  4 slots (224 px each), same size as history cards                    -->
            <!--    Slot1 x=8   Conn x=274  Slot2 x=340  Conn x=606                    -->
            <!--    Slot3 x=672 Conn x=938  Slot4 x=1004                               -->
            <!-- ====================================================================== -->
            <GuiElement profile="frPlanTimeline" position="20px -144px">
                <!-- == Slot 1: AN 1 == -->
                <GuiElement profile="frPlanSlotCard" position="8px -4px">
                    <RoundCorner     profile="frPlanSlotCardBg"/>
                    <Text            profile="frPlanSlotYear"      id="planSlotYear[1]"     text="$l10n_fr_plan_year1"/>
                    <Bitmap          profile="frPlanSlotCropIcon"  id="planSlotIcon[1]"     visible="false"/>
                    <MultiTextOption profile="frPlanSlotSelector"  id="planSlotSelector[1]" onClick="onChangePlanSlot1"/>
                    <RoundCorner     profile="frPlanSlotBadgeBg"   id="planSlotBadge[1]"    visible="false"/>
                    <Text            profile="frPlanSlotBadgeText" id="planSlotBadgeText[1]" text="" visible="false"/>
                </GuiElement>

                <!-- Connector 1 -->
                <GuiElement profile="frPlanTimelineConnector" position="274px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 2: AN 2 == -->
                <GuiElement profile="frPlanSlotCard" position="340px -4px">
                    <RoundCorner     profile="frPlanSlotCardBg"/>
                    <Text            profile="frPlanSlotYear"      id="planSlotYear[2]"     text="$l10n_fr_plan_year2"/>
                    <Bitmap          profile="frPlanSlotCropIcon"  id="planSlotIcon[2]"     visible="false"/>
                    <MultiTextOption profile="frPlanSlotSelector"  id="planSlotSelector[2]" onClick="onChangePlanSlot2"/>
                    <RoundCorner     profile="frPlanSlotBadgeBg"   id="planSlotBadge[2]"    visible="false"/>
                    <Text            profile="frPlanSlotBadgeText" id="planSlotBadgeText[2]" text="" visible="false"/>
                </GuiElement>

                <!-- Connector 2 -->
                <GuiElement profile="frPlanTimelineConnector" position="606px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 3: AN 3 == -->
                <GuiElement profile="frPlanSlotCard" position="672px -4px">
                    <RoundCorner     profile="frPlanSlotCardBg"/>
                    <Text            profile="frPlanSlotYear"      id="planSlotYear[3]"     text="$l10n_fr_plan_year3"/>
                    <Bitmap          profile="frPlanSlotCropIcon"  id="planSlotIcon[3]"     visible="false"/>
                    <MultiTextOption profile="frPlanSlotSelector"  id="planSlotSelector[3]" onClick="onChangePlanSlot3"/>
                    <RoundCorner     profile="frPlanSlotBadgeBg"   id="planSlotBadge[3]"    visible="false"/>
                    <Text            profile="frPlanSlotBadgeText" id="planSlotBadgeText[3]" text="" visible="false"/>
                </GuiElement>

                <!-- Connector 3 -->
                <GuiElement profile="frPlanTimelineConnector" position="938px -4px">
                    <RoundCorner profile="frTimelineConnectorLine"/>
                    <Text        profile="frTimelineArrowText" text=">"/>
                </GuiElement>

                <!-- == Slot 4: AN 4 == -->
                <GuiElement profile="frPlanSlotCard" position="1004px -4px">
                    <RoundCorner     profile="frPlanSlotCardBg"/>
                    <Text            profile="frPlanSlotYear"      id="planSlotYear[4]"     text="$l10n_fr_plan_year4"/>
                    <Bitmap          profile="frPlanSlotCropIcon"  id="planSlotIcon[4]"     visible="false"/>
                    <MultiTextOption profile="frPlanSlotSelector"  id="planSlotSelector[4]" onClick="onChangePlanSlot4"/>
                    <RoundCorner     profile="frPlanSlotBadgeBg"   id="planSlotBadge[4]"    visible="false"/>
                    <Text            profile="frPlanSlotBadgeText" id="planSlotBadgeText[4]" text="" visible="false"/>
                </GuiElement>

            </GuiElement>

            <!-- == SECTION: QUALITÉ DE ROTATION (y=-330) == -->
            <GuiElement profile="frSectionBar" position="0px -330px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_fr_section_score"/>
            </GuiElement>

            <!-- == SCORE CARD (y=-374..444) == -->
            <GuiElement profile="frScoreCard" position="20px -374px">
                <RoundCorner profile="frScoreCardBg"/>
                <ThreePartBitmap profile="frScoreAccent"/>
                <Text        profile="frScoreText"        id="scoreText"       text=""/>
                <RoundCorner profile="frScoreTrack"       id="scoreTrack"/>
                <GuiElement  profile="frScoreCursorPos"   id="scoreCursorPos">
                    <RoundCorner profile="frScoreCursor"  id="scoreCursor"/>
                </GuiElement>
                <Text profile="frScoreLabelLeft"  id="scoreLabelLeft"  text="$l10n_fr_score_label_low"/>
                <Text profile="frScoreLabelRight" id="scoreLabelRight" text="$l10n_fr_score_label_optimal"/>
            </GuiElement>

            <!-- == SECTION: APERÇU GLOBAL (y=-476) == -->
            <GuiElement profile="frSectionBar" position="0px -476px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_fr_section_overview"/>
                <Text profile="frOverviewTotalArea" id="overviewTotalArea" text=""/>
            </GuiElement>

            <!-- == GLOBAL OVERVIEW LIST (y=-520..790) == -->
            <GuiElement profile="frOverviewWrap" position="20px -520px">
                <RoundCorner profile="frOverviewBg"/>

                <GuiElement profile="frOverviewInner">
                <Bitmap profile="fs25_subCategoryStartClipper" name="startClipperOv"/>
                <Bitmap profile="fs25_subCategoryStopClipper"  name="endClipperOv"/>

                <SmoothList profile="frOverviewList" id="listPlanOverview"
                    startClipperElementName="startClipperOv"
                    endClipperElementName="endClipperOv"
                    handleFocus="false"
                    listItemSpacing="10px">

                    <!-- groupRow: one compact row = one unique rotation pattern -->
                    <ListItem profile="frOverviewListItem" name="groupRow">
                        <!-- Card visuals -->
                        <RoundCorner profile="frGroupCardBg"      name="gCardBg"/>
                        <RoundCorner profile="frGroupCountLane"   name="gCountLane"/>
                        <ThreePartBitmap profile="frGroupCardAccent" name="gCardAccent"/>

                        <!-- Field count -->
                        <Text profile="frGroupCount" name="gCount" position="9px -14px" text=""/>
                        <Text profile="frGroupArea"  name="gArea"  position="9px -50px" text=""/>

                        <!-- Empty-group summary -->
                        <Text profile="frGroupPlanSummary" name="gPlanSummary" position="132px -18px" text="" visible="false"/>

                        <!-- Year labels (y=5) — visible only when badge is visible -->
                        <Text profile="frGroupYearLabel" name="gYearLabel1" position="132px -5px"  text="$l10n_fr_plan_year1" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel2" position="334px -5px"  text="$l10n_fr_plan_year2" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel3" position="536px -5px"  text="$l10n_fr_plan_year3" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel4" position="738px -5px"  text="$l10n_fr_plan_year4" visible="false"/>

                        <!-- Zone 1 (y=18, +4px from previous) -->
                        <RoundCorner profile="frGroupBadge"      name="gBadge1" position="132px -18px" visible="false"/>
                        <Bitmap      profile="frGroupCropIconCard" name="gCropIcon1" position="132px -23px" visible="false"/>
                        <Text        profile="frGroupBadgeLabel" name="gLabel1" position="157px -18px" size="170px 30px" text="" visible="false"/>

                        <!-- Arrow 1 -->
                        <Text profile="frGroupArrow" name="gArrow1" position="310px -23px" text=">" visible="false"/>

                        <!-- Zone 2 -->
                        <RoundCorner profile="frGroupBadge"      name="gBadge2" position="334px -18px" visible="false"/>
                        <Bitmap      profile="frGroupCropIconCard" name="gCropIcon2" position="334px -23px" visible="false"/>
                        <Text        profile="frGroupBadgeLabel" name="gLabel2" position="359px -18px" size="170px 30px" text="" visible="false"/>

                        <!-- Arrow 2 -->
                        <Text profile="frGroupArrow" name="gArrow2" position="512px -23px" text=">" visible="false"/>

                        <!-- Zone 3 -->
                        <RoundCorner profile="frGroupBadge"      name="gBadge3" position="536px -18px" visible="false"/>
                        <Bitmap      profile="frGroupCropIconCard" name="gCropIcon3" position="536px -23px" visible="false"/>
                        <Text        profile="frGroupBadgeLabel" name="gLabel3" position="561px -18px" size="170px 30px" text="" visible="false"/>

                        <!-- Arrow 3 -->
                        <Text profile="frGroupArrow" name="gArrow3" position="714px -23px" text=">" visible="false"/>

                        <!-- Zone 4 -->
                        <RoundCorner profile="frGroupBadge"      name="gBadge4" position="738px -18px" visible="false"/>
                        <Bitmap      profile="frGroupCropIconCard" name="gCropIcon4" position="738px -23px" visible="false"/>
                        <Text        profile="frGroupBadgeLabel" name="gLabel4" position="763px -18px" size="170px 30px" text="" visible="false"/>

                        <!-- Score -->
                        <Text profile="frOverviewScore" name="gScore" text=""/>

                        <!-- Field names (bottom strip) -->
                        <Text profile="frGroupFieldNames" name="gFieldNames" text=""/>
                    </ListItem>

                    <ListItem profile="fs25_subCategoryListItemEmpty" name="empty"/>
                </SmoothList>

                <ThreePartBitmap profile="frOverviewSliderBox">
                    <Slider profile="frOverviewSlider" dataElementId="listPlanOverview"/>
                </ThreePartBitmap>
                </GuiElement>
            </GuiElement>

        </GuiElement>

        <!-- Shown when no fields are owned -->
        <Text profile="frEmptyText" id="emptyText" text="$l10n_fr_empty_no_fields"/>

    </GuiElement>

</GUI>
