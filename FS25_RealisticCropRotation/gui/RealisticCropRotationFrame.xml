<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="RealisticCropRotationFrame">

    <!-- ============================ LEFT SIDEBAR ============================ -->
    <ThreePartBitmap profile="fs25_primaryMenuContainerBg">
        <Bitmap profile="fs25_menuContainerArrow"/>

        <GuiElement profile="fs25_subCategoryContainer">

            <!-- View tab selector: cycles HISTORY <-> PLANNING -->
            <MultiTextOption profile="fs25_subCategorySelector" id="viewSelector" onClick="onViewChanged"/>

            <BoxLayout profile="fs25_subCategorySelectorBox" id="viewSelectorDotBox">
                <RoundCorner profile="fs25_subCategorySelectorDot"/>
                <RoundCorner profile="fs25_subCategorySelectorDot"/>
            </BoxLayout>

            <GuiElement profile="fs25_subCategoryListContainer">
                <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
                <Bitmap profile="fs25_subCategoryStopClipper"  name="endClipper"/>

                <SmoothList profile="frSidebarList" id="listFields"
                    startClipperElementName="startClipper"
                    endClipperElementName="endClipper"
                    handleFocus="true"
                    listItemSpacing="-20px">

                    <ListItem profile="fs25_subCategoryListItem" name="field">
                        <RoundCorner profile="fs25_subCategoryListItemIcon" name="cropIconBackground" visible="false"/>
                        <Bitmap profile="fs25_subCategoryListItemIcon" name="cropIcon"  visible="false"/>
                        <Text   profile="frSidebarItemName"            name="fieldName" text="-"/>
                        <Text   profile="frSidebarItemArea"            name="fieldArea" text=""/>
                        <Text   profile="frSidebarItemCropLine"        name="cropLine"  text=""/>
                    </ListItem>

                    <ListItem profile="fs25_subCategoryListItemEmpty" name="empty"/>
                </SmoothList>

                <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="listFields"/>
                </ThreePartBitmap>
            </GuiElement>

        </GuiElement>
    </ThreePartBitmap>

    <!-- ============================ RIGHT PANE ============================ -->
    <GuiElement profile="fs25_menuContentContainer">

        <GuiElement profile="fs25_menuHeaderPanel" position="0px 74px">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="realisticCropRotation.menuIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="menuHeaderTitle" text="$l10n_realisticCropRotation_menu_title"/>
        </GuiElement>

        <!-- ===================== DETAIL CONTAINER ===================== -->
        <!--                                                              -->
        <!--  Balanced layout — leaves room for the FS25 bottom help bar: -->
        <!--    Hero           y=   0  h= 56                             -->
        <!--    Section HIST   y= -66  h= 32                             -->
        <!--    Timeline       y=-112  h=186   gap title/card = 14       -->
        <!--    Section N      y=-330  h= 32   group gap = 32            -->
        <!--    N gauge        y=-374  h= 54   gap title/card = 12       -->
        <!--    Section LIME   y=-452  h= 32   group gap = 24            -->
        <!--    Lime / pH      y=-496  h= 54                             -->
        <!--    Section ADVICE y=-574  h= 32                             -->
        <!--    Advice         y=-618  h= 64                             -->
        <!--    Section FIELD  y=-706  h= 32                             -->
        <!--    Field card     y=-750  h= 82                             -->
        <!--    Total: 832 px                                             -->
        <!-- ============================================================ -->
        <GuiElement profile="frDetailContainer" id="detailsContainer">

            <!-- == HERO CARD (y=0..56) == -->
            <GuiElement profile="frHeroCard" position="0px 0px">
                <RoundCorner     profile="frHeroCardBg"/>
                <ThreePartBitmap profile="frHeroAccent"/>
                <Text profile="frHeroTitle" id="detailTitle"  text="-"/>
                <GuiElement profile="frWeatherPill" id="weatherPill" visible="false">
                    <RoundCorner profile="frWeatherPillBg" id="weatherPillBg"/>
                    <Bitmap      profile="frWeatherPillIcon" id="weatherPillIcon"/>
                    <Text        profile="frWeatherPillText" id="weatherPillText" text=""/>
                </GuiElement>
                <RoundCorner profile="frStatusPillBg"   id="statusPillBg"/>
                <Text        profile="frStatusPillText" id="statusPillText" text=""/>
            </GuiElement>

            <!-- == SECTION: CROP HISTORY (y=-66) == -->
            <GuiElement profile="frSectionBar" position="0px -66px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_rcr_section_history"/>
            </GuiElement>

            <!-- == TIMELINE STRIP (y=-112..298) == -->
            <!--                                                               -->
            <!--  Slot x-positions (w=224, connector gap=25):                 -->
            <!--    Slot1 x=8   Conn x=232  Slot2 x=257  Conn x=481           -->
            <!--    Slot3 x=506 Conn x=730  Slot4 x=755  Conn x=979           -->
            <!--    Slot5 x=1004                                               -->
            <!-- ============================================================ -->
            <GuiElement profile="frTimeline" position="20px -112px">
                <!-- == Slot 1: CURRENT active crop / ground state (leftmost) == -->
                <GuiElement profile="frSlotCard" position="8px -4px">
                    <RoundCorner profile="frSlotCardBgCurrent"/>
                    <ThreePartBitmap profile="frSlotAccentCurrent"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot1SeasonLabel" text="$l10n_rcr_slot_current"/>
                    <Bitmap      profile="frSlotIcon"            id="slot1Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot1CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot1BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot1BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 1 -->
                <GuiElement profile="frHistoryTimelineConnector" position="232px -4px">
                    <Bitmap profile="frTimelineArrowIcon"/>
                </GuiElement>

                <!-- == Slot 2: N-1 == -->
                <GuiElement profile="frSlotCard" position="257px -4px">
                    <RoundCorner profile="frSlotCardBgN1"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot2SeasonLabel" text="$l10n_rcr_slot_n1"/>
                    <Bitmap      profile="frSlotIcon"            id="slot2Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot2CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot2BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot2BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 2 -->
                <GuiElement profile="frHistoryTimelineConnector" position="481px -4px">
                    <Bitmap profile="frTimelineArrowIcon"/>
                </GuiElement>

                <!-- == Slot 3: N-2 == -->
                <GuiElement profile="frSlotCard" position="506px -4px">
                    <RoundCorner profile="frSlotCardBgN2"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot3SeasonLabel" text="$l10n_rcr_slot_n2"/>
                    <Bitmap      profile="frSlotIcon"            id="slot3Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot3CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot3BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot3BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 3 -->
                <GuiElement profile="frHistoryTimelineConnector" position="730px -4px">
                    <Bitmap profile="frTimelineArrowIcon"/>
                </GuiElement>

                <!-- == Slot 4: N-3 == -->
                <GuiElement profile="frSlotCard" position="755px -4px">
                    <RoundCorner     profile="frSlotCardBgN3"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot4SeasonLabel" text="$l10n_rcr_slot_n3"/>
                    <Bitmap      profile="frSlotIcon"            id="slot4Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot4CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot4BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot4BadgeText"   text="" visible="false"/>
                </GuiElement>

                <!-- Connector 4 -->
                <GuiElement profile="frHistoryTimelineConnector" position="979px -4px">
                    <Bitmap profile="frTimelineArrowIcon"/>
                </GuiElement>

                <!-- == Slot 5: N-4 (oldest, rightmost) == -->
                <GuiElement profile="frSlotCard" position="1004px -4px">
                    <RoundCorner profile="frSlotCardBgN4"/>
                    <Text        profile="frSlotSeasonLabel"     id="slot5SeasonLabel" text="$l10n_rcr_slot_n4"/>
                    <Bitmap      profile="frSlotIcon"            id="slot5Icon"        visible="false"/>
                    <Text        profile="frSlotCropName"        id="slot5CropName"    text=""/>
                    <RoundCorner profile="frSlotFamilyBadgeBg"   id="slot5BadgeBg"     visible="false"/>
                    <Text        profile="frSlotFamilyBadgeText" id="slot5BadgeText"   text="" visible="false"/>
                </GuiElement>

            </GuiElement>

            <!-- == SECTION: NITROGEN STATUS (y=-330) == -->
            <GuiElement profile="frSectionBar" position="0px -330px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentN" position="14px 0px"/>
                <Text profile="frSectionTitleN" text="$l10n_rcr_section_nitrogen"/>
            </GuiElement>

            <!-- == NITROGEN GAUGE CARD (y=-374..428) == -->
            <GuiElement profile="frNitrogenCard" position="20px -374px">
                <RoundCorner profile="frNitrogenCardBg"/>
                <Text        profile="frNitrogenStateLabel" id="nitrogenStateLabel" text=""/>
                <Text        profile="frNitrogenValueLabel" id="nitrogenValueLabel" text="" visible="false"/>
                <RoundCorner profile="frNitrogenTrack"/>
                <RoundCorner profile="frNitrogenFill"      id="nitrogenBarFill"    visible="false"/>
            </GuiElement>

            <!-- == SECTION: LIME / PH STATUS (y=-452) == -->
            <GuiElement profile="frSectionBar" position="0px -452px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentN" position="14px 0px"/>
                <Text profile="frSectionTitleN" text="$l10n_rcr_section_lime"/>
            </GuiElement>

            <!-- == LIME / PH GAUGE CARD (y=-496..550) == -->
            <GuiElement profile="frNitrogenCard" position="20px -496px">
                <RoundCorner profile="frNitrogenCardBg"/>
                <Text        profile="frNitrogenStateLabel" id="limeStateLabel" text=""/>
                <Text        profile="frLimeValueLabel"     id="limeValueLabel" text="" visible="false"/>
                <RoundCorner profile="frNitrogenTrack"/>
                <RoundCorner profile="frLimeFill"           id="limeBarFill"    visible="false"/>
            </GuiElement>

            <!-- == SECTION: AGRONOMIC ADVICE (y=-574) == -->
            <GuiElement profile="frSectionBar" position="0px -574px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentAdvice" position="14px 0px"/>
                <Text profile="frSectionTitleAdvice" text="$l10n_rcr_section_advice"/>
            </GuiElement>

            <!-- == ADVICE CARD (y=-618..682) == -->
            <GuiElement profile="frAdviceCard" position="20px -618px">
                <RoundCorner     profile="frAdviceCardBg"/>
                <ThreePartBitmap profile="frAdviceAccent"/>
                <Text            profile="frAdviceText" id="adviceText" text=""/>
            </GuiElement>

            <!-- == SECTION: FIELD (soil work / weed / growth) (y=-706) == -->
            <GuiElement profile="frSectionBar" position="0px -706px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccentField" position="14px 0px"/>
                <Text profile="frSectionTitleField" text="$l10n_rcr_section_field"/>
            </GuiElement>

            <!-- == FIELD CARD (y=-750..832) == -->
            <GuiElement profile="frFieldCard" position="20px -750px">
                <RoundCorner     profile="frFieldCardBg"/>
                <ThreePartBitmap profile="frFieldAccent"/>

                <GuiElement profile="frFieldKpi" position="0px 0px">
                    <Text profile="frFieldKpiLabel" text="$l10n_rcr_action_header"/>
                    <Text profile="frFieldKpiValueNA" id="requiredActionValue" text="-"/>
                </GuiElement>

                <RoundCorner profile="frFieldDivider" position="-207px -18px"/>

                <GuiElement profile="frFieldKpi" position="413px 0px">
                    <Text profile="frFieldKpiLabel" id="weedHeaderText" text="$l10n_rcr_weed_header"/>
                    <Text profile="frFieldKpiValueNA" id="weedValue" text="-"/>
                </GuiElement>

                <RoundCorner profile="frFieldDivider" position="207px -18px"/>

                <GuiElement profile="frFieldKpi" position="827px 0px">
                    <Text profile="frFieldKpiLabel" text="$l10n_rcr_field_growth"/>
                    <Text profile="frFieldKpiValueNA" id="growthValue" text="-"/>
                </GuiElement>
            </GuiElement>

        </GuiElement>

        <!-- ===================== PLANNING CONTAINER (tab 2) ===================== -->
        <!--                                                                        -->
        <!--  Layout — same y-origin as detailsContainer (y=0 = top of card):      -->
        <!--    Hero           y=   0  h= 56                                        -->
        <!--    Section PLAN   y= -66  h= 32                                        -->
        <!--    Calendar       y=-112  h=238   gap title/card = 14                  -->
        <!--    Section SCORE  y=-366  h= 32   group gap = 16                       -->
        <!--    Score card     y=-410  h= 56   gap title/card = 12                  -->
        <!--    Section GLOBAL y=-476  h= 32   group gap = 10                       -->
        <!--    Overview       y=-520  h=312   gap title/card = 12                  -->
        <!--    Total: 832 px                                                        -->
        <!-- =================================================================== -->
        <GuiElement profile="frPlanContainer" id="planningContainer" visible="false">

            <!-- == HERO CARD (y=0..56) == -->
            <GuiElement profile="frHeroCard" position="0px 0px">
                <RoundCorner     profile="frHeroCardBg"/>
                <ThreePartBitmap profile="frHeroAccent"/>
                <Text profile="frHeroTitle" id="planTitle"  text="-"/>
                <GuiElement profile="frWeatherPill" id="planWeatherPill" visible="false">
                    <RoundCorner profile="frWeatherPillBg" id="planWeatherPillBg"/>
                    <Bitmap      profile="frWeatherPillIcon" id="planWeatherPillIcon"/>
                    <Text        profile="frWeatherPillText" id="planWeatherPillText" text=""/>
                </GuiElement>
                <RoundCorner profile="frStatusPillBg"   id="planStatusPillBg"/>
                <Text        profile="frStatusPillText" id="planStatusPillText" text=""/>
            </GuiElement>

            <!-- == SECTION: ROTATION PLAN (y=-66) == -->
            <GuiElement profile="frSectionBar" position="0px -66px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_rcr_section_plan"/>
            </GuiElement>

            <!-- == ANNUAL ROTATION CALENDAR (y=-112..350) == -->
            <GuiElement profile="frCalendarTimeline" position="20px -112px">
                <RoundCorner profile="frCalendarBg"/>

                <GuiElement profile="frCalendarEditor">
                    <MultiTextOption profile="frCalendarEditCropSelector" id="calendarEditCropSelector" onClick="onChangeCalendarEditCrop"/>
                    <MultiTextOption profile="frCalendarEditCoverSelector" id="calendarEditCoverSelector" onClick="onChangeCalendarEditCover"/>
                </GuiElement>

                <GuiElement profile="frCalendarLegend" id="calendarLegend">
                    <Text profile="frCalendarLegendLabel" id="calendarLegendLabelSow" text="$l10n_rcr_calendar_legend_sowing"/>
                    <RoundCorner profile="frCalendarLegendSwatchSow" id="calendarLegendSwatchSow"/>
                    <Text profile="frCalendarLegendLabel" id="calendarLegendLabelHarvest" text="$l10n_rcr_calendar_legend_harvest"/>
                    <RoundCorner profile="frCalendarLegendSwatchHarvest" id="calendarLegendSwatchHarvest"/>
                    <Text profile="frCalendarLegendLabel" id="calendarLegendLabelCover" text="$l10n_rcr_calendar_legend_cover"/>
                    <RoundCorner profile="frCalendarLegendSwatchCover" id="calendarLegendSwatchCover"/>
                </GuiElement>

                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[1]"  text="$l10n_rcr_calendar_month_1"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[2]"  text="$l10n_rcr_calendar_month_2"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[3]"  text="$l10n_rcr_calendar_month_3"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[4]"  text="$l10n_rcr_calendar_month_4"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[5]"  text="$l10n_rcr_calendar_month_5"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[6]"  text="$l10n_rcr_calendar_month_6"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[7]"  text="$l10n_rcr_calendar_month_7"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[8]"  text="$l10n_rcr_calendar_month_8"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[9]"  text="$l10n_rcr_calendar_month_9"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[10]" text="$l10n_rcr_calendar_month_10"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[11]" text="$l10n_rcr_calendar_month_11"/>
                <Text profile="frCalendarMonthLabel" id="calendarMonthLabel[12]" text="$l10n_rcr_calendar_month_12"/>

                <!-- N+1 -->
                <GuiElement profile="frCalendarRow" position="0px -54px">
                    <RoundCorner profile="frCalendarRowBg" id="calendarRowBg[1]"/>
                    <Text profile="frCalendarStepLabel" id="calendarStepLabel[1]" text="$l10n_rcr_plan_year1"/>
                    <Bitmap profile="frCalendarCropIcon" id="calendarCropIcon[1]" visible="false"/>
                    <Bitmap profile="frCalendarCoverIcon" id="calendarCoverIcon[1]" visible="false"/>
                    <RoundCorner profile="frCalendarCropBar" id="calendarCropBar[1]" visible="false"/>
                    <RoundCorner profile="frCalendarHarvestBar" id="calendarHarvestBar[1]" visible="false"/>
                    <RoundCorner profile="frCalendarCoverMarker" id="calendarCoverMarker[1]" visible="false"/>
                    <Button profile="frCalendarRowButton" id="calendarRowButton[1]" onClick="onCalendarRowClicked"/>
                </GuiElement>

                <!-- N+2 -->
                <GuiElement profile="frCalendarRow" position="0px -97px">
                    <RoundCorner profile="frCalendarRowBg" id="calendarRowBg[2]"/>
                    <Text profile="frCalendarStepLabel" id="calendarStepLabel[2]" text="$l10n_rcr_plan_year2"/>
                    <Bitmap profile="frCalendarCropIcon" id="calendarCropIcon[2]" visible="false"/>
                    <Bitmap profile="frCalendarCoverIcon" id="calendarCoverIcon[2]" visible="false"/>
                    <RoundCorner profile="frCalendarCropBar" id="calendarCropBar[2]" visible="false"/>
                    <RoundCorner profile="frCalendarHarvestBar" id="calendarHarvestBar[2]" visible="false"/>
                    <RoundCorner profile="frCalendarCoverMarker" id="calendarCoverMarker[2]" visible="false"/>
                    <Button profile="frCalendarRowButton" id="calendarRowButton[2]" onClick="onCalendarRowClicked"/>
                </GuiElement>

                <!-- N+3 -->
                <GuiElement profile="frCalendarRow" position="0px -140px">
                    <RoundCorner profile="frCalendarRowBg" id="calendarRowBg[3]"/>
                    <Text profile="frCalendarStepLabel" id="calendarStepLabel[3]" text="$l10n_rcr_plan_year3"/>
                    <Bitmap profile="frCalendarCropIcon" id="calendarCropIcon[3]" visible="false"/>
                    <Bitmap profile="frCalendarCoverIcon" id="calendarCoverIcon[3]" visible="false"/>
                    <RoundCorner profile="frCalendarCropBar" id="calendarCropBar[3]" visible="false"/>
                    <RoundCorner profile="frCalendarHarvestBar" id="calendarHarvestBar[3]" visible="false"/>
                    <RoundCorner profile="frCalendarCoverMarker" id="calendarCoverMarker[3]" visible="false"/>
                    <Button profile="frCalendarRowButton" id="calendarRowButton[3]" onClick="onCalendarRowClicked"/>
                </GuiElement>

                <!-- N+4 -->
                <GuiElement profile="frCalendarRow" position="0px -183px">
                    <RoundCorner profile="frCalendarRowBg" id="calendarRowBg[4]"/>
                    <Text profile="frCalendarStepLabel" id="calendarStepLabel[4]" text="$l10n_rcr_plan_year4"/>
                    <Bitmap profile="frCalendarCropIcon" id="calendarCropIcon[4]" visible="false"/>
                    <Bitmap profile="frCalendarCoverIcon" id="calendarCoverIcon[4]" visible="false"/>
                    <RoundCorner profile="frCalendarCropBar" id="calendarCropBar[4]" visible="false"/>
