                </GuiElement>

                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[1]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[2]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[3]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[4]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[5]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[6]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[7]"/>
