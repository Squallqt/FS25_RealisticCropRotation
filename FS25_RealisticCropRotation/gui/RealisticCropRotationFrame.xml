                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[9]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[10]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[11]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[12]"/>
                <RoundCorner profile="frCalendarMonthGridLine" id="calendarMonthGridLine[13]"/>

                <RoundCorner profile="frCalendarHeaderSep"/>

                <GuiElement profile="frCalendarTodayMarker" id="calendarTodayMarker">
                    <Bitmap profile="frCalendarTodayDash" position="36px -53px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -67px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -81px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -95px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -109px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -123px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -137px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -151px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -165px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -179px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -193px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -207px"/>
                    <Bitmap profile="frCalendarTodayDash" position="36px -221px"/>
                </GuiElement>
            </GuiElement>

            <!-- == SECTION: ROTATION QUALITY (y=-366) == -->
            <GuiElement profile="frSectionBar" position="0px -366px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_rcr_section_score"/>
            </GuiElement>

            <!-- == SCORE CARD (y=-410..466) == -->
            <GuiElement profile="frScoreCard" position="20px -410px">
                <RoundCorner profile="frScoreCardBg"/>
                <Text        profile="frScoreText"        id="scoreText"       text=""/>
                <RoundCorner profile="frScoreTrack"       id="scoreTrack"/>
                <GuiElement  profile="frScoreCursorPos"   id="scoreCursorPos">
