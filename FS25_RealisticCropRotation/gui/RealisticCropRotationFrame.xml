            <!-- == SECTION: GLOBAL OVERVIEW (y=-476) == -->
            <GuiElement profile="frSectionBar" position="0px -476px">
                <RoundCorner profile="frSectionBarBg"/>
                <RoundCorner profile="frSectionAccent" position="14px 0px"/>
                <Text profile="frSectionTitle" text="$l10n_rcr_section_overview"/>
                <Text profile="frOverviewTotalArea" id="overviewTotalArea" text=""/>
            </GuiElement>

            <!-- == GLOBAL OVERVIEW LIST (y=-520..790) == -->
            <GuiElement profile="frOverviewWrap" position="20px -520px">
                <RoundCorner profile="frOverviewBg"/>

                <GuiElement profile="frOverviewInner">
                <Bitmap profile="fs25_subCategoryStartClipper" name="startClipperOv"/>
                <Bitmap profile="fs25_subCategoryStopClipper"  name="endClipperOv"/>

                <SmoothList profile="frOverviewList" id="listPlanOverview"
                    startClipperElementName="startClipperOv"
                    endClipperElementName="endClipperOv"
                    handleFocus="false"
                    listItemSpacing="10px">

                    <!-- groupRow: one compact row = one unique rotation pattern -->
                    <ListItem profile="frOverviewListItem" name="groupRow">
                        <!-- Card visuals -->
                        <RoundCorner profile="frGroupCardBg"      name="gCardBg"/>
                        <RoundCorner profile="frGroupCountLane"   name="gCountLane"/>
                        <ThreePartBitmap profile="frGroupCardAccent" name="gCardAccent"/>

                        <!-- Field count -->
                        <Text profile="frGroupCount" name="gCount" position="9px -14px" text=""/>
                        <Text profile="frGroupArea"  name="gArea"  position="9px -50px" text=""/>

                        <!-- Empty-group summary -->
                        <Text profile="frGroupPlanSummary" name="gPlanSummary" position="132px -18px" text="" visible="false"/>

                        <!-- Year labels (y=5) — visible only when badge is visible -->
                        <Text profile="frGroupYearLabel" name="gYearLabel1" position="132px -5px"  text="$l10n_rcr_plan_year1" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel2" position="334px -5px"  text="$l10n_rcr_plan_year2" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel3" position="536px -5px"  text="$l10n_rcr_plan_year3" visible="false"/>
                        <Text profile="frGroupYearLabel" name="gYearLabel4" position="738px -5px"  text="$l10n_rcr_plan_year4" visible="false"/>

