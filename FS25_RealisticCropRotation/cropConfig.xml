<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Crop configuration: add a <crop> line to register a new crop, no Lua editing required -->
<realisticCropRotationCrops>

    <!-- Crops reference these shared disease groups by name. -->
    <!-- annualRetention controls yearly local persistence; plannerInterval only controls advice. -->
    <!-- ambient is the external exposure floor. -->
    <diseaseGroups>
        <diseaseGroup name="SCLEROTINIA" state="1" plannerInterval="3" rotationRelevant="true"
                      reservoirClass="MIXED" annualRetention="0.56" infectFrom="0.50" infectTo="0.80"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="2.0" ambient="0.03"
                      dailyGrowth="0.05"  destroySeverity="0.25" deadFractionMax="0.85" />
        <diseaseGroup name="PHOMA"       state="2" plannerInterval="4" rotationRelevant="true"
                      reservoirClass="RECENT" annualRetention="0.46" infectFrom="0.20" infectTo="0.70"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="1.8" ambient="0.02"
                      dailyGrowth="0.03"  destroySeverity="0.30" deadFractionMax="0.55" />
        <diseaseGroup name="TAKEALL"     state="3" plannerInterval="2" rotationRelevant="true"
                      reservoirClass="RECENT" annualRetention="0.10" infectFrom="0.30" infectTo="0.80"
                      weatherDriven="false" treatment="NONE" ambient="0.01"
                      dailyGrowth="0.035" destroySeverity="0.30" deadFractionMax="0.55" />
        <diseaseGroup name="SEPTORIA"    state="4" plannerInterval="2" rotationRelevant="false"
                      reservoirClass="RECENT" annualRetention="0.10" infectFrom="0.25" infectTo="0.75"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="2.3" ambient="0.09"
                      dailyGrowth="0.045" destroySeverity="0.25" deadFractionMax="0.55" />
        <diseaseGroup name="RUST"        state="5" plannerInterval="0" rotationRelevant="false"
                      reservoirClass="NONE" annualRetention="0.00" infectFrom="0.30" infectTo="0.85"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="2.4" ambient="0.10"
                      dailyGrowth="0.05"  destroySeverity="0.25" deadFractionMax="0.60" />
        <diseaseGroup name="FUSARIUM"    state="6" plannerInterval="2" rotationRelevant="true"
                      reservoirClass="RECENT" annualRetention="0.32" infectFrom="0.50" infectTo="0.80"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="2.0" ambient="0.05"
                      dailyGrowth="0.035" destroySeverity="0.30" deadFractionMax="0.45" />
        <diseaseGroup name="LATEBLIGHT"  state="7" plannerInterval="0" rotationRelevant="false"
                      reservoirClass="NONE" annualRetention="0.00" infectFrom="0.15" infectTo="0.85"
                      weatherDriven="true" treatment="FUNGICIDE" weatherFactor="2.0" ambient="0.10"
                      dailyGrowth="0.05"  destroySeverity="0.28" deadFractionMax="0.70" />
        <diseaseGroup name="BCN"         state="8" plannerInterval="3" rotationRelevant="true"
                      reservoirClass="PERSISTENT" annualRetention="0.70" infectFrom="0.10" infectTo="0.90"
                      weatherDriven="false" treatment="NEMATICIDE" ambient="0.01"
                      dailyGrowth="0.015" destroySeverity="0.30" deadFractionMax="0.45" />
        <diseaseGroup name="CLUBROOT"    state="9" plannerInterval="6" rotationRelevant="true"
                      reservoirClass="PERSISTENT" annualRetention="0.82" infectFrom="0.10" infectTo="0.60"
                      weatherDriven="false" treatment="NONE" ambient="0.01"
                      dailyGrowth="0.02"  destroySeverity="0.30" deadFractionMax="0.60" />
    </diseaseGroups>

    <!-- Cereals -->
    <crop name="WHEAT"         family="CEREAL" disease="TAKEALL SEPTORIA RUST FUSARIUM" />
    <crop name="BARLEY"        family="CEREAL" disease="TAKEALL SEPTORIA RUST FUSARIUM" />
    <crop name="OAT"           family="CEREAL" disease="RUST FUSARIUM" />
    <crop name="RYE"           family="CEREAL" disease="TAKEALL RUST FUSARIUM" />
    <crop name="TRITICALE"     family="CEREAL" disease="TAKEALL SEPTORIA RUST FUSARIUM" />
    <crop name="SPELT"         family="CEREAL" disease="TAKEALL SEPTORIA" />
    <crop name="MAIZE"         family="CEREAL" disease="FUSARIUM" />
    <crop name="SORGHUM"       family="CEREAL" disease="FUSARIUM" />
    <crop name="WINTERWHEAT"   family="CEREAL" disease="TAKEALL SEPTORIA RUST FUSARIUM" />
    <crop name="WINTERBARLEY"  family="CEREAL" disease="TAKEALL SEPTORIA RUST FUSARIUM" />
    <crop name="RICE"          family="CEREAL" />
    <crop name="RICELONGGRAIN" family="CEREAL" />
    <crop name="SILAGEMAIZE"   family="CEREAL" disease="FUSARIUM" />
    <crop name="GREENRYE"      family="CEREAL" disease="TAKEALL" />

    <!-- Oilseeds -->
    <crop name="CANOLA"    family="OILSEED" disease="SCLEROTINIA PHOMA RUST BCN CLUBROOT" />
    <crop name="SUNFLOWER" family="OILSEED" disease="SCLEROTINIA RUST" />
    <crop name="MUSTARD"   family="OILSEED" disease="SCLEROTINIA PHOMA BCN CLUBROOT" />
    <!-- Legumes (n1/n2 in PF states; 1 state = 5 kg N/ha) -->
    <crop name="SOYBEAN"   family="LEGUME" n1="8"  n2="2"  disease="SCLEROTINIA" />
    <crop name="ALFALFA"   family="LEGUME" n1="16" n2="10" />
    <crop name="CLOVER"    family="LEGUME" n1="10" n2="4"  />
    <crop name="PEA"       family="LEGUME" n1="8"  n2="2"  disease="SCLEROTINIA" />
    <crop name="GREENBEAN" family="LEGUME" n1="4"  n2="1"  disease="SCLEROTINIA" />
    <crop name="VETCHRYE"  family="LEGUME" n1="12" n2="4"  />

    <!-- Root vegetables -->
    <crop name="SUGARBEET" family="ROOT" disease="BCN" />
    <crop name="POTATO"    family="ROOT" disease="SCLEROTINIA LATEBLIGHT" />
    <crop name="CARROT"    family="ROOT" disease="SCLEROTINIA" />
    <crop name="PARSNIP"   family="ROOT" />
    <crop name="BEETROOT"  family="ROOT" disease="BCN" />

    <!-- Leaf / bulb vegetables -->
    <crop name="SPINACH" family="VEGETABLE" disease="BCN" />
    <crop name="ONION"   family="VEGETABLE" />

    <!-- Forage / grass -->
    <crop name="GRASS"      family="FORAGE" />
    <crop name="FIELDGRASS" family="FORAGE" />

    <!-- Cover crops (excluded from rotation history) -->
    <crop name="OILSEEDRADISH"      family="COVER" cover="true" />
    <crop name="FLOWERINGCATCHCROP" family="COVER" cover="true" />

</realisticCropRotationCrops>
