<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="rcrSprayer_materialHolder" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Files>
    <File fileId="1" filename="fungicideSpray_diffuse.dds"/>
    <File fileId="2" filename="nematicideSpray_diffuse.dds"/>
    <File fileId="3" filename="$data/effects/sprayer/water_normal.dds"/>
    <File fileId="4" filename="$data/effects/sprayer/water_specular.dds"/>
    <File fileId="5" filename="$data/shaders/sprayerShader.xml"/>
  </Files>

  <Materials>
    <Material name="fungicideSpray_mat" materialId="1" alphaBlending="true" customShaderId="5">
      <Texture fileId="1"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
      <CustomParameter name="isFadeAboveTerrain" value="1"/>
    </Material>
    <Material name="nematicideSpray_mat" materialId="2" alphaBlending="true" customShaderId="5">
      <Texture fileId="2"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
      <CustomParameter name="isFadeAboveTerrain" value="1"/>
    </Material>
  </Materials>

  <Shapes externalShapesFile="rcrSprayer_materialHolder.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="sprayerEffects" nodeId="1">
      <TransformGroup name="materials" nodeId="2">
        <Shape name="fungicideSpray_materialHolder" shapeId="1" clipDistance="10" nodeId="3" castsShadows="true" receiveShadows="true" materialHolder="true" materialIds="1"/>
        <Shape name="nematicideSpray_materialHolder" shapeId="1" clipDistance="10" nodeId="4" castsShadows="true" receiveShadows="true" materialHolder="true" materialIds="2"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

  <UserAttributes>
    <UserAttribute nodeId="3">
      <Attribute name="fillType" type="string" value="RCR_FUNGICIDE"/>
      <Attribute name="materialIndex" type="string" value="1"/>
      <Attribute name="materialType" type="string" value="sprayer"/>
      <Attribute name="onCreate" type="scriptCallback" value="MaterialUtil.onCreateMaterial"/>
    </UserAttribute>
    <UserAttribute nodeId="4">
      <Attribute name="fillType" type="string" value="RCR_NEMATICIDE"/>
      <Attribute name="materialIndex" type="string" value="1"/>
      <Attribute name="materialType" type="string" value="sprayer"/>
      <Attribute name="onCreate" type="scriptCallback" value="MaterialUtil.onCreateMaterial"/>
    </UserAttribute>
  </UserAttributes>
</i3D>
