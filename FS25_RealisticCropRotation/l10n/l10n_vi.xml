        <e k="rcr_disease_name_septoriose" v="Bệnh đốm lá Septoria" />
        <e k="rcr_disease_name_rouille" v="Bệnh gỉ sắt" />
        <e k="rcr_disease_name_fusariose" v="Bệnh cháy bông Fusarium" />
        <e k="rcr_disease_name_mildiou" v="Bệnh mốc sương" />
        <e k="rcr_disease_name_hernie" v="Bệnh sưng rễ họ cải" />
        <e k="rcr_disease_desc_sclerotinia" v="Bệnh mốc trắng ở cây lấy dầu, cây họ đậu và cây lấy củ vào thời kỳ ra hoa; hạch nấm tồn tại trong đất nhiều năm, phát triển mạnh khi ra hoa gặp ẩm." />
        <e k="rcr_disease_desc_phoma" v="Bệnh loét thân cải dầu/mù tạt lây qua tàn dư; cần khoảng cách dài giữa các vụ cây lấy dầu, nặng hơn khi mùa thu ẩm ướt." />
        <e k="rcr_disease_desc_pietin" v="Bệnh thối rễ ở ngũ cốc trồng liên tục; chỉ phá vỡ được bằng cây không phải ký chủ (yến mạch, họ đậu, cây lấy dầu). Không có thuốc trừ nấm hiệu quả." />
        <e k="rcr_disease_desc_septoriose" v="Bệnh lá chính của lúa mì/lúa mạch, lây lan do nước mưa bắn từ tàn dư; bùng phát mạnh trong mùa xuân ẩm ướt." />
        <e k="rcr_disease_desc_rouille" v="Bệnh gỉ sắt nâu/vàng ở ngũ cốc và hướng dương/cải dầu; bùng phát khi thời tiết ôn hòa ẩm ướt, phát tán theo gió." />
        <e k="rcr_disease_desc_fusariose" v="Bệnh cháy bông do tàn dư ngũ cốc và ngô (ngô→lúa mì) thúc đẩy; nguy hiểm nhất khi ra hoa gặp ẩm, làm hạt bị lép." />
        <e k="rcr_disease_desc_mildiou" v="Bệnh mốc sương khoai tây; chi phối bởi thời tiết mát và ẩm, ít phụ thuộc vào luân canh; phá hủy cả ruộng trong vài ngày." />
        <e k="rcr_disease_desc_bcn" v="Tuyến trùng bào nang củ cải đường; bào nang tồn tại trong đất nhiều năm, gây stress mãn tính theo từng đám; luân canh là biện pháp chính." />
        <e k="rcr_disease_desc_hernie" v="Bệnh sưng rễ; bào tử nghỉ tồn tại trên sáu năm, cần khoảng cách rất dài giữa các vụ cây họ cải; không có thuốc hóa học." />
        <e k="rcr_disease_treatment_sclerotinia" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_phoma" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_pietin" v="Không (luân canh)" />
        <e k="rcr_disease_treatment_septoriose" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_rouille" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_fusariose" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_mildiou" v="Thuốc trừ nấm" />
        <e k="rcr_disease_treatment_bcn" v="Thuốc trừ tuyến trùng" />
        <e k="rcr_fillType_fungicide" v="Thuốc trừ nấm" />
        <e k="rcr_fillType_nematicide" v="Thuốc trừ tuyến trùng" />
        <e k="rcr_disease_treatment_hernie" v="Không (giống kháng bệnh, bón vôi, luân canh)" />
        <e k="rcr_advice_pressure_high_phoma" v="Áp lực Phoma cao — tránh cải dầu và mù tạt khoảng 4 năm, vùi tàn dư; phun thuốc trừ nấm mùa thu trên giống mẫn cảm." />
        <e k="rcr_advice_pressure_high_pietin" v="Áp lực thối rễ cao — chèn một vụ cây không phải ký chủ (yến mạch, họ đậu, cây lấy dầu); không có thuốc trừ nấm hiệu quả, chỉ luân canh mới khắc phục." />
        <e k="rcr_advice_pressure_high_septoriose" v="Áp lực đốm lá cao — tránh trồng lúa mì/lúa mạch trên tàn dư ngũ cốc, chọn giống chịu bệnh; phun thuốc trừ nấm từ giai đoạn vươn lóng ở vùng khí hậu ẩm." />
        <e k="rcr_advice_pressure_high_rouille" v="Áp lực gỉ sắt cao — gieo giống kháng bệnh và dự trù thuốc trừ nấm; theo dõi những đợt thời tiết ôn hòa ẩm ướt." />
        <e k="rcr_advice_pressure_high_fusariose" v="Áp lực cháy bông cao — tránh trồng lúa mì sau ngô, vùi tàn dư; phun thuốc trừ nấm khi ra hoa nếu gặp mưa." />
        <e k="rcr_advice_pressure_high_mildiou" v="Áp lực mốc sương cao — trồng giống kháng bệnh và bảo vệ khoai tây bằng thuốc trừ nấm ngay khi trời trở mát và ẩm." />
        <e k="rcr_advice_pressure_high_hernie" v="Áp lực sưng rễ cao — giãn cách cây họ cải trên 6 năm, bón vôi để nâng pH và gieo giống kháng bệnh; không có thuốc hóa học." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Áp lực Phoma trung bình — kéo dài khoảng cách vụ cải dầu và băm nhỏ gốc rạ." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Áp lực thối rễ trung bình — tránh vụ ngũ cốc thứ ba liên tiếp." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Áp lực đốm lá trung bình — theo dõi mưa xuân và nguồn bệnh trong tàn dư." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Áp lực gỉ sắt trung bình — kiểm tra các ổ bào tử (vết bệnh) khi thời tiết ôn hòa." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Áp lực cháy bông trung bình — giãn cách ngũ cốc và ngô, quản lý tàn dư." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Áp lực mốc sương trung bình — theo dõi thời tiết mát ẩm và tiêu hủy cây tự mọc." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Áp lực sưng rễ trung bình — kéo dài khoảng cách vụ cải dầu và theo dõi pH chua." />
