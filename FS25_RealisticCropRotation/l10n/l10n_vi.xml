        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Sau cây ngũ cốc, gieo cây họ đậu để hoàn trả đạm hoặc cây cắt vụ chống bệnh thối gốc, và giữ khoảng cách hai năm giữa các vụ ngũ cốc." />
        <e k="rcr_advice_afterLegume" v="Sau cây họ đậu, ngũ cốc tận dụng tốt nhất lượng đạm để lại, và cây họ đậu tiếp theo nên chờ ba năm." />
        <e k="rcr_advice_afterOilseed" v="Sau cây lấy dầu, để ba năm trước khi bất kỳ cây lấy dầu nào quay lại, với ngũ cốc rồi cây họ đậu là trình tự lý tưởng." />
        <e k="rcr_advice_afterRoot" v="Sau cây lấy củ, chờ bốn năm trước khi cây lấy củ quay lại, tiếp theo là ngũ cốc để tái tạo cấu trúc đất sau thu hoạch muộn." />
        <e k="rcr_advice_afterVegetable" v="Sau rau, chờ ba năm trước khi lặp lại, với ngũ cốc làm khoảng nghỉ sạch." />
        <e k="rcr_advice_afterForage" v="Sau đồng cỏ tạm thời, ngũ cốc tận dụng độ phì và cấu trúc tích lũy dưới lớp cỏ." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Nguy cơ thối hạch cao: giãn cách ít nhất 3 năm giữa cải dầu, mù tạt, hướng dương, đậu tương, đậu Hà Lan, đậu, khoai tây và cà rốt; thuốc trừ nấm hạn chế thiệt hại trên phần đã phun nhưng không loại bỏ bệnh khỏi ruộng." />
        <e k="rcr_advice_pressure_high_bcn"           v="Nguy cơ tuyến trùng cao: giãn cách ít nhất 3 năm giữa củ cải đường, củ dền, cải dầu, mù tạt và rau chân vịt; thuốc trừ tuyến trùng bảo vệ phần đã xử lý nhưng không loại bỏ tuyến trùng." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Nguy cơ thối hạch trung bình: giãn cách cải dầu, mù tạt, hướng dương, đậu tương, đậu Hà Lan, đậu, khoai tây và cà rốt; mưa làm tăng nguy cơ." />
        <e k="rcr_advice_pressure_moderate_bcn"         v="Nguy cơ tuyến trùng trung bình: giãn cách củ cải đường, củ dền, cải dầu, mù tạt và rau chân vịt." />
        <e k="rcr_advice_no_current_crop" v="Không có cây trồng chính hiện tại: tư vấn sẽ có khi phát hiện cây trồng." />

