        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Sau cây ngũ cốc, gieo cây họ đậu để hoàn trả đạm hoặc cây cắt vụ chống bệnh thối gốc, và giữ khoảng cách hai năm giữa các vụ ngũ cốc." />
        <e k="rcr_advice_afterLegume" v="Sau cây họ đậu, ngũ cốc tận dụng tốt nhất lượng đạm để lại, và cây họ đậu tiếp theo nên chờ ba năm." />
        <e k="rcr_advice_afterOilseed" v="Sau cây lấy dầu, để ba năm trước khi bất kỳ cây lấy dầu nào quay lại, với ngũ cốc rồi cây họ đậu là trình tự lý tưởng." />
        <e k="rcr_advice_afterRoot" v="Sau cây lấy củ, chờ bốn năm trước khi cây lấy củ quay lại, tiếp theo là ngũ cốc để tái tạo cấu trúc đất sau thu hoạch muộn." />
        <e k="rcr_advice_afterVegetable" v="Sau rau, chờ ba năm trước khi lặp lại, với ngũ cốc làm khoảng nghỉ sạch." />
        <e k="rcr_advice_afterForage" v="Sau đồng cỏ tạm thời, ngũ cốc tận dụng độ phì và cấu trúc tích lũy dưới lớp cỏ." />
        <e k="rcr_advice_disease_sclerotinia" v="Cây này là ký chủ của bệnh thối hạch, vì vậy hãy giữ ít nhất ba năm cách cải dầu, hướng dương, đậu tương, đậu Hà Lan và đậu." />
        <e k="rcr_advice_disease_bcn" v="Cây này là ký chủ của tuyến trùng bào nang củ cải đường, vì vậy hãy giữ củ cải đường và cây họ cải tách biệt rõ." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Áp lực bệnh thối hạch cao trên thửa ruộng này — tránh trồng cải dầu, hướng dương, đậu tương, đậu Hà Lan và đậu cô ve ít nhất ba năm." />
        <e k="rcr_advice_pressure_high_bcn"           v="Áp lực tuyến trùng bào nang củ cải cao trên thửa ruộng này — tránh trồng củ cải đường, củ dền, cải dầu, cải mù tạt và rau chân vịt ít nhất ba năm." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Áp lực bệnh thối hạch ở mức trung bình trên thửa ruộng này — bố trí luân canh cây ký chủ cẩn thận." />
        <e k="rcr_advice_pressure_moderate_bcn"         v="Áp lực tuyến trùng bào nang củ cải ở mức trung bình trên thửa ruộng này — bố trí luân canh cây họ củ cải và cải bắp cẩn thận." />
        <e k="rcr_advice_no_current_crop" v="Không có cây trồng chính hiện tại: tư vấn sẽ có khi phát hiện cây trồng." />

