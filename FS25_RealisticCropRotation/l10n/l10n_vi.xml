        <e k="rcr_advice_pressure_high_phoma" v="Áp lực Phoma cao: tránh cải dầu và mù tạt khoảng 4 năm, vùi tàn dư; phun thuốc trừ nấm mùa thu trên giống mẫn cảm." />
        <e k="rcr_advice_pressure_high_takeall" v="Áp lực thối rễ cao: chèn một vụ cây không phải ký chủ (yến mạch, họ đậu, cây lấy dầu); không có thuốc trừ nấm hiệu quả, chỉ luân canh mới khắc phục." />
        <e k="rcr_advice_pressure_high_septoria" v="Áp lực đốm lá cao: tránh trồng lúa mì/lúa mạch trên tàn dư ngũ cốc, chọn giống chịu bệnh; phun thuốc trừ nấm từ giai đoạn vươn lóng ở vùng khí hậu ẩm." />
        <e k="rcr_advice_pressure_high_rust" v="Áp lực gỉ sắt cao: gieo giống kháng bệnh và dự trù thuốc trừ nấm; theo dõi những đợt thời tiết ôn hòa ẩm ướt." />
        <e k="rcr_advice_pressure_high_fusarium" v="Áp lực cháy bông cao: tránh trồng lúa mì sau ngô, vùi tàn dư; phun thuốc trừ nấm khi ra hoa nếu gặp mưa." />
        <e k="rcr_advice_pressure_high_lateblight" v="Áp lực mốc sương cao: trồng giống kháng bệnh và bảo vệ khoai tây bằng thuốc trừ nấm ngay khi trời trở mát và ẩm." />
        <e k="rcr_advice_pressure_high_clubroot" v="Áp lực sưng rễ cao: giãn cách cây họ cải trên 6 năm, bón vôi để nâng pH và gieo giống kháng bệnh; không có thuốc hóa học." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Áp lực Phoma trung bình: kéo dài khoảng cách vụ cải dầu và băm nhỏ gốc rạ." />
        <e k="rcr_advice_pressure_moderate_takeall" v="Áp lực thối rễ trung bình: tránh vụ ngũ cốc thứ ba liên tiếp." />
        <e k="rcr_advice_pressure_moderate_septoria" v="Áp lực đốm lá trung bình: theo dõi mưa xuân và nguồn bệnh trong tàn dư." />
        <e k="rcr_advice_pressure_moderate_rust" v="Áp lực gỉ sắt trung bình: kiểm tra các ổ bào tử (vết bệnh) khi thời tiết ôn hòa." />
        <e k="rcr_advice_pressure_moderate_fusarium" v="Áp lực cháy bông trung bình: giãn cách ngũ cốc và ngô, quản lý tàn dư." />
        <e k="rcr_advice_pressure_moderate_lateblight" v="Áp lực mốc sương trung bình: theo dõi thời tiết mát ẩm và tiêu hủy cây tự mọc." />
        <e k="rcr_advice_pressure_moderate_clubroot" v="Áp lực sưng rễ trung bình: kéo dài khoảng cách vụ cải dầu và theo dõi pH chua." />
