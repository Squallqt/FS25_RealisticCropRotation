        <e k="rcr_disease_desc_sclerotinia" v="Öljykasvien, palkokasvien ja juurikasvien pahkahome kukinnan aikaan; rihmastopahkat säilyvät maassa vuosia, kosteaa kukintaa suosiva." />
        <e k="rcr_disease_desc_phoma" v="Rapsin ja sinapin varsitauti, joka leviää kasvijätteiden mukana; vaatii pitkän tauon öljykasveista, syksyn kosteus pahentaa sitä." />
        <e k="rcr_disease_desc_pietin" v="Jatkuvan viljanviljelyn tyvi- ja juuristomätä; katkeaa vain isäntäkasviksi kelpaamattomalla kasvilla (kaura, palkokasvi, öljykasvi). Ei tehokasta sienitorjunta-ainetta." />
        <e k="rcr_disease_desc_septoriose" v="Vehnän ja ohran tärkein lehtitauti, leviää sadepisaroiden roiskeina kasvijätteistä; kostealla keväällä puhkeaa rajusti." />
        <e k="rcr_disease_desc_rouille" v="Viljojen sekä auringonkukan/rapsin ruskea- ja keltaruoste; leudolla kostealla säällä leviää nopeasti tuulen mukana." />
        <e k="rcr_disease_desc_fusariose" v="Tähkän punahometta suosivat viljan ja maissin jätteet (maissi→vehnä); kriittinen kostean kukinnan aikaan, kuivettaa jyvän." />
        <e k="rcr_disease_desc_mildiou" v="Perunarutto; kylmän ja kostean sään ohjaama, vähän viljelykierrosta riippuvainen; tuhoaa kasvuston muutamassa päivässä." />
        <e k="rcr_disease_desc_bcn" v="Juurikkaan ankeroinen; kystat säilyvät maassa vuosia, krooninen laikuttainen stressi; viljelykierto on tärkein keino." />
        <e k="rcr_disease_desc_hernie" v="Möhöjuuri; lepoitiöt säilyvät maassa yli kuusi vuotta, vaatii hyvin pitkän tauon ristikukkaisista; ei kemiallista torjuntaa." />
        <e k="rcr_disease_treatment_sclerotinia" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_phoma" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_pietin" v="Ei mitään (viljelykierto)" />
        <e k="rcr_disease_treatment_septoriose" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_rouille" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_fusariose" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_mildiou" v="Sienitorjunta-aine" />
        <e k="rcr_disease_treatment_bcn" v="Ankeroistorjunta-aine" />
        <e k="rcr_fillType_fungicide" v="Sienitorjunta-aine" />
        <e k="rcr_fillType_nematicide" v="Ankeroistorjunta-aine" />
        <e k="rcr_disease_treatment_hernie" v="Ei mitään (kestävä lajike, kalkitus, viljelykierto)" />
        <e k="rcr_advice_pressure_high_phoma" v="Korkea Phoman paine — vältä rapsia ja sinappia noin 4 vuotta, muokkaa kasvijätteet maahan; syksyn sienitorjunta-aine alttiille lajikkeille." />
        <e k="rcr_advice_pressure_high_pietin" v="Korkea tyvimädän paine — lisää isäntäkasviksi kelpaamaton katkokasvi (kaura, palkokasvi, öljykasvi); mikään sienitorjunta-aine ei tehoa, vain viljelykierto parantaa." />
        <e k="rcr_advice_pressure_high_septoriose" v="Korkea Septorian paine — älä viljele vehnää/ohraa viljan jätteillä, valitse kestävä lajike; kosteassa ilmastossa sienitorjunta-aine korrenkasvusta alkaen." />
        <e k="rcr_advice_pressure_high_rouille" v="Korkea ruosteen paine — kylvä kestävä lajike ja suunnittele sienitorjunta-aine; tarkkaile leutoja kosteita jaksoja." />
        <e k="rcr_advice_pressure_high_fusariose" v="Korkea punahomeen paine — älä viljele vehnää maissin jälkeen, muokkaa kasvijätteet maahan; sienitorjunta-aine kukinnan aikaan sateella." />
        <e k="rcr_advice_pressure_high_mildiou" v="Korkea perunaruton paine — istuta kestävä lajike ja suojaa perunat sienitorjunta-aineella heti kun sää viilenee ja kostuu." />
        <e k="rcr_advice_pressure_high_hernie" v="Korkea möhöjuuren paine — tauko ristikukkaisista yli 6 vuotta, nosta pH:ta kalkitsemalla ja kylvä kestävä lajike; ei kemiallista torjuntaa." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Kohtalainen Phoman paine — pidennä taukoa rapsista ja silppua sänki." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Kohtalainen tyvimädän paine — vältä kolmatta viljaa peräkkäin." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Kohtalainen Septorian paine — tarkkaile kevätsateita ja kasvijätteiden tartuntaa." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Kohtalainen ruosteen paine — etsi itiöpesäkkeitä leudolla säällä." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Kohtalainen punahomeen paine — harvenna viljaa ja maissia, käsittele kasvijätteet." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Kohtalainen perunaruton paine — seuraa kylmää kosteaa säätä ja hävitä jälkikasvustot." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Kohtalainen möhöjuuren paine — pidennä taukoa rapsista ja tarkkaile hapanta pH:ta." />
