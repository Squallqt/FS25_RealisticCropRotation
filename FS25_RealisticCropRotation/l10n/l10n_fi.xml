        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Viljan jälkeen kylvä palkokasvi typen palauttamiseksi tai katkaisukasvi tyvitauteja vastaan, ja pidä kaksi vuotta viljojen välissä." />
        <e k="rcr_advice_afterLegume" v="Palkokasvin jälkeen vilja hyödyntää jätetyn typen parhaiten, ja seuraavan palkokasvin tulisi odottaa kolme vuotta." />
        <e k="rcr_advice_afterOilseed" v="Öljykasvin jälkeen jätä kolme vuotta ennen minkään öljykasvin paluuta, vilja ja sitten palkokasvi ihanteellisena järjestyksenä." />
        <e k="rcr_advice_afterRoot" v="Juurikasvin jälkeen odota neljä vuotta ennen juurikasvien paluuta, ja jatka viljalla rakenteen palauttamiseksi myöhäisen noston jälkeen." />
        <e k="rcr_advice_afterVegetable" v="Vihanneksen jälkeen odota kolme vuotta ennen sen toistamista, vilja puhtaana katkona." />
        <e k="rcr_advice_afterForage" v="Lyhytaikaisen nurmen jälkeen vilja hyödyntää turpeen alle kertyneen viljavuuden ja rakenteen." />
        <e k="rcr_advice_current_crop_disease_hosts" v="Tämän kasvin tautikohtaiset paluuvälit (vuotta): %s." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Korkea pahkahomeen paine — vältä rapsia, auringonkukkaa, soijapapua, hernettä, papua, perunaa ja porkkanaa vähintään 3 vuotta; sienitorjunta-aine kukinnan aikaan kostealla säällä." />
        <e k="rcr_advice_pressure_high_bcn"           v="Korkea ankeroisen paine — vältä sokerijuurikasta, punajuurta, rapsia, sinappia ja pinaattia 3 vuotta; ankeroistorjunta-aine tai kestävä pyydyskasvi." />
