        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Po zbożu zasiej roślinę bobowatą, aby przywrócić azot, lub roślinę przerywającą przeciw chorobom podstawy źdźbła, i zachowaj dwa lata między zbożami." />
        <e k="rcr_advice_afterLegume" v="Po roślinie bobowatej zboże najlepiej wykorzysta pozostawiony azot, a kolejna bobowata powinna poczekać trzy lata." />
        <e k="rcr_advice_afterOilseed" v="Po roślinie oleistej odczekaj trzy lata przed powrotem jakiejkolwiek oleistej, ze zbożem, a potem bobowatą jako idealnym następstwem." />
        <e k="rcr_advice_afterRoot" v="Po roślinie okopowej odczekaj cztery lata przed powrotem okopowych, a następnie zboże, aby odbudować strukturę po późnym zbiorze." />
        <e k="rcr_advice_afterVegetable" v="Po warzywie odczekaj trzy lata przed jego powtórzeniem, ze zbożem jako czystą przerwą." />
        <e k="rcr_advice_afterForage" v="Po użytku przemiennym z trawą zboże wykorzystuje żyzność i strukturę zgromadzone pod darnią." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Wysokie ryzyko zgnilizny twardzikowej: zachowaj co najmniej 3 lata odstępu między rzepakiem, gorczycą, słonecznikiem, soją, grochem, fasolą, ziemniakiem i marchwią; fungicyd ogranicza szkody na opryskanych fragmentach, ale nie usuwa choroby z pola." />
        <e k="rcr_advice_pressure_high_bcn"           v="Wysokie ryzyko mątwika: zachowaj co najmniej 3 lata odstępu między burakiem cukrowym, burakiem ćwikłowym, rzepakiem, gorczycą i szpinakiem; nematocyd chroni opryskane fragmenty, ale nie usuwa nicieni." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Umiarkowane ryzyko zgnilizny twardzikowej: zwiększ odstęp między rzepakiem, gorczycą, słonecznikiem, soją, grochem, fasolą, ziemniakiem i marchwią; deszcz zwiększa ryzyko." />
