        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="După o cereală, semănă o leguminoasă pentru a reface azotul sau o cultură de întrerupere împotriva bolilor bazei tulpinii, și lasă doi ani între cereale." />
        <e k="rcr_advice_afterLegume" v="După o leguminoasă, o cereală valorifică cel mai bine azotul lăsat, iar o nouă leguminoasă trebuie să aștepte trei ani." />
        <e k="rcr_advice_afterOilseed" v="După o oleaginoasă, lasă trei ani înainte de revenirea oricărei oleaginoase, cu o cereală și apoi o leguminoasă ca succesiune ideală." />
        <e k="rcr_advice_afterRoot" v="După o cultură de rădăcinoase, așteaptă patru ani înainte de revenirea rădăcinoaselor, urmată de o cereală pentru a reface structura după recoltarea târzie." />
        <e k="rcr_advice_afterVegetable" v="După o legumă, așteaptă trei ani înainte de a o repeta, cu o cereală ca întrerupere curată." />
        <e k="rcr_advice_afterForage" v="După o pajiște temporară, o cereală valorifică fertilitatea și structura acumulate sub covorul ierbos." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Presiune mare de putregai alb: evitați rapița, muștarul, floarea-soarelui, soia, mazărea, fasolea, cartoful și morcovul cel puțin 3 ani; fungicidul salvează recolta pe zonele tratate, nu face boala să regreseze." />
        <e k="rcr_advice_pressure_high_bcn"           v="Presiune mare de nematozi: evitați sfecla de zahăr, sfecla roșie, rapița, muștarul și spanacul 3 ani; nematicidul salvează recolta pe zonele tratate timp de 3 luni." />
