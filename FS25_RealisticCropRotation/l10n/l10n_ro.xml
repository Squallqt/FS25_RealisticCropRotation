        <!-- Disease system (9 pathogens) -->
        <e k="rcr_disease_name_phoma" v="Putregaiul uscat / cancerul tulpinii (Phoma)" />
        <e k="rcr_disease_name_pietin" v="Înnegrirea bazei paiului" />
        <e k="rcr_disease_name_septoriose" v="Septorioza frunzelor" />
        <e k="rcr_disease_name_rouille" v="Rugina" />
        <e k="rcr_disease_name_fusariose" v="Fuzarioza spicului" />
        <e k="rcr_disease_name_mildiou" v="Mana cartofului" />
        <e k="rcr_disease_name_hernie" v="Hernia rădăcinilor de crucifere" />
        <e k="rcr_disease_desc_sclerotinia" v="Putregaiul alb al plantelor oleaginoase, leguminoaselor și rădăcinoaselor la înflorire; scleroții persistă în sol mai mulți ani, este favorizat de o înflorire umedă." />
        <e k="rcr_disease_desc_phoma" v="Cancerul tulpinii de rapiță/muștar transmis prin resturile vegetale; necesită o pauză lungă a oleaginoaselor, agravat de umezeala de toamnă." />
        <e k="rcr_disease_desc_pietin" v="Înnegrirea bazei paiului la cerealele cultivate continuu; întreruptă doar de o cultură negazdă (ovăz, leguminoasă, oleaginoasă). Niciun fungicid eficient." />
        <e k="rcr_disease_desc_septoriose" v="Principala boală foliară a grâului/orzului, răspândită prin stropii de ploaie de pe resturi; explozivă într-o primăvară umedă." />
        <e k="rcr_disease_desc_rouille" v="Ruginile brună și galbenă ale cerealelor și ale florii-soarelui/rapiței; explozive pe vreme blândă și umedă, purtate de vânt." />
        <e k="rcr_disease_desc_fusariose" v="Fuzarioza spicului favorizată de resturile de cereale și porumb (porumb→grâu); critică la o înflorire umedă, șiștăvește bobul." />
        <e k="rcr_disease_desc_mildiou" v="Mana cartofului; determinată de vremea răcoroasă și umedă, dependență redusă de rotație; distruge cultura în câteva zile." />
        <e k="rcr_disease_desc_bcn" v="Nematodul cu chisturi al sfeclei; chisturile persistă în sol mai mulți ani, stres cronic în vetre; rotația este pârghia principală." />
        <e k="rcr_disease_desc_hernie" v="Hernia rădăcinilor de crucifere; sporii de rezistență persistă peste șase ani, necesită o pauză foarte lungă a cruciferelor; niciun tratament chimic." />
        <e k="rcr_disease_treatment_sclerotinia" v="Fungicid" />
        <e k="rcr_disease_treatment_phoma" v="Fungicid" />
        <e k="rcr_disease_treatment_pietin" v="Niciunul (rotație)" />
        <e k="rcr_disease_treatment_septoriose" v="Fungicid" />
        <e k="rcr_disease_treatment_rouille" v="Fungicid" />
        <e k="rcr_disease_treatment_fusariose" v="Fungicid" />
        <e k="rcr_disease_treatment_mildiou" v="Fungicid" />
        <e k="rcr_disease_treatment_bcn" v="Nematicid" />
        <e k="rcr_fillType_fungicide" v="Fungicid" />
        <e k="rcr_fillType_nematicide" v="Nematicid" />
        <e k="rcr_disease_treatment_hernie" v="Niciunul (soi rezistent, amendare cu var, rotație)" />
        <e k="rcr_advice_pressure_high_phoma" v="Presiune mare de Phoma — evitați rapița și muștarul circa 4 ani, încorporați resturile; fungicid de toamnă pe soiurile sensibile." />
        <e k="rcr_advice_pressure_high_pietin" v="Presiune mare de înnegrire a bazei paiului — introduceți o pauză cu o cultură negazdă (ovăz, leguminoasă, oleaginoasă); niciun fungicid nu ajută, doar rotația vindecă." />
        <e k="rcr_advice_pressure_high_septoriose" v="Presiune mare de septorioză — nu cultivați grâu/orz pe resturi de cereale, alegeți un soi tolerant; fungicid de la alungirea paiului în climat umed." />
        <e k="rcr_advice_pressure_high_rouille" v="Presiune mare de rugină — semănați un soi rezistent și planificați un fungicid; urmăriți perioadele blânde și umede." />
        <e k="rcr_advice_pressure_high_fusariose" v="Presiune mare de fuzarioză — evitați grâul după porumb, încorporați resturile; fungicid la înflorire dacă plouă." />
        <e k="rcr_advice_pressure_high_mildiou" v="Presiune mare de mană — plantați un soi rezistent și protejați cartofii cu fungicid de îndată ce devine răcoros și umed." />
        <e k="rcr_advice_pressure_high_hernie" v="Presiune mare de hernie — pauză a cruciferelor peste 6 ani, amendați cu var pentru a ridica pH-ul și semănați un soi rezistent; niciun tratament chimic." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Presiune moderată de Phoma — prelungiți pauza rapiței și tocați miriștea." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Presiune moderată de înnegrire a bazei paiului — evitați a treia cereală la rând." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Presiune moderată de septorioză — urmăriți ploile de primăvară și inoculul din resturi." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Presiune moderată de rugină — pe vreme blândă căutați pustulele." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Presiune moderată de fuzarioză — răriți cerealele și porumbul, gestionați resturile." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Presiune moderată de mană — urmăriți vremea răcoroasă și umedă și distrugeți samulastra." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Presiune moderată de hernie — prelungiți pauza rapiței și supravegheați pH-ul acid." />
