        <!-- Disease system (9 pathogens) -->
        <e k="rcr_disease_name_phoma" v="Torröta (Phoma)" />
        <e k="rcr_disease_name_pietin" v="Rotdödare" />
        <e k="rcr_disease_name_septoriose" v="Svartpricksjuka (Septoria)" />
        <e k="rcr_disease_name_rouille" v="Rost" />
        <e k="rcr_disease_name_fusariose" v="Axfusarios (Fusarium)" />
        <e k="rcr_disease_name_mildiou" v="Potatisbladmögel" />
        <e k="rcr_disease_name_hernie" v="Klumprotsjuka" />
        <e k="rcr_disease_desc_sclerotinia" v="Vitröta i oljeväxter, baljväxter och rotfrukter vid blomning; sklerotier överlever i marken i åratal, gynnas av en fuktig blomning." />
        <e k="rcr_disease_desc_phoma" v="Stjälkröta i raps/senap som sprids med skörderester; kräver ett långt uppehåll från oljeväxter, förvärras av höstfukt." />
        <e k="rcr_disease_desc_pietin" v="Rotdödare i ensidig spannmålsodling; bryts endast av en icke-värdgröda (havre, baljväxt, oljeväxt). Inget effektivt svampmedel." />
        <e k="rcr_disease_desc_septoriose" v="Viktigaste bladsjukdomen i vete/korn, sprids med regnstänk från skörderester; explosiv under en våt vår." />
        <e k="rcr_disease_desc_rouille" v="Brunrost och gulrost i spannmål samt solros/raps; explosiv i milt fuktigt väder, sprids med vinden." />
        <e k="rcr_disease_desc_fusariose" v="Axfusarios som gynnas av spannmåls- och majsrester (majs→vete); kritisk vid en våt blomning, skrumpnar kärnan." />
        <e k="rcr_disease_desc_mildiou" v="Potatisbladmögel; drivs av svalt vått väder, litet beroende av växtföljd; förstör grödan på några dagar." />
        <e k="rcr_disease_desc_bcn" v="Betcystnematod; cystor överlever i marken i åratal, kronisk fläckvis stress; växtföljden är den viktigaste hävstången." />
        <e k="rcr_disease_desc_hernie" v="Klumprotsjuka; vilsporer överlever i över sex år, kräver ett mycket långt uppehåll från korsblommiga; ingen kemisk behandling." />
        <e k="rcr_disease_treatment_sclerotinia" v="Svampmedel" />
        <e k="rcr_disease_treatment_phoma" v="Svampmedel" />
        <e k="rcr_disease_treatment_pietin" v="Ingen (växtföljd)" />
        <e k="rcr_disease_treatment_septoriose" v="Svampmedel" />
        <e k="rcr_disease_treatment_rouille" v="Svampmedel" />
        <e k="rcr_disease_treatment_fusariose" v="Svampmedel" />
        <e k="rcr_disease_treatment_mildiou" v="Svampmedel" />
        <e k="rcr_disease_treatment_bcn" v="Nematicid" />
        <e k="rcr_fillType_fungicide" v="Svampmedel" />
        <e k="rcr_fillType_nematicide" v="Nematicid" />
        <e k="rcr_disease_treatment_hernie" v="Ingen (resistent sort, kalkning, växtföljd)" />
        <e k="rcr_advice_pressure_high_phoma" v="Högt torrötetryck — undvik raps och senap i cirka 4 år, myllna ned skörderester; höstsvampmedel på mottagliga sorter." />
        <e k="rcr_advice_pressure_high_pietin" v="Högt rotdödartryck — lägg in en icke-värdgröda som avbrott (havre, baljväxt, oljeväxt); inget svampmedel hjälper, bara växtföljd botar." />
        <e k="rcr_advice_pressure_high_septoriose" v="Högt svartpricksjuketryck — undvik vete/korn på spannmålsrester, välj en tolerant sort; svampmedel från stråskjutning i ett vått klimat." />
        <e k="rcr_advice_pressure_high_rouille" v="Högt rosttryck — så en resistent sort och planera ett svampmedel; håll koll på milda fuktiga perioder." />
        <e k="rcr_advice_pressure_high_fusariose" v="Högt fusariostryck — undvik vete efter majs, myllna ned skörderester; svampmedel vid blomning om vått." />
        <e k="rcr_advice_pressure_high_mildiou" v="Högt bladmögeltryck — plantera en resistent sort och skydda potatis med svampmedel så snart det blir svalt och vått." />
        <e k="rcr_advice_pressure_high_hernie" v="Högt klumprotstryck — uppehåll från korsblommiga i över 6 år, kalka för att höja pH och så en resistent sort; ingen kemisk behandling." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Måttligt torrötetryck — förläng uppehållet från raps och hacka sönder stubben." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Måttligt rotdödartryck — undvik en tredje spannmål i rad." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Måttligt svartpricksjuketryck — håll koll på vårregn och smitta i skörderester." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Måttligt rosttryck — leta efter pustler i milt väder." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Måttligt fusariostryck — sprid ut spannmål och majs, hantera skörderester." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Måttligt bladmögeltryck — övervaka svalt vått väder och förstör spillplantor." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Måttligt klumprotstryck — förläng uppehållet från raps och håll koll på surt pH." />
