        <e k="rcr_disease_treatment_rouille" v="Фунгіцид" />
        <e k="rcr_disease_treatment_fusariose" v="Фунгіцид" />
        <e k="rcr_disease_treatment_mildiou" v="Фунгіцид" />
        <e k="rcr_disease_treatment_bcn" v="Нематицид" />
        <e k="rcr_fillType_fungicide" v="Фунгіцид" />
        <e k="rcr_fillType_nematicide" v="Нематицид" />
