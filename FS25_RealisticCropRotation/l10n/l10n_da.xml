        <e k="rcr_disease_treatment_septoriose" v="Svampemiddel" />
        <e k="rcr_disease_treatment_rouille" v="Svampemiddel" />
        <e k="rcr_disease_treatment_fusariose" v="Svampemiddel" />
        <e k="rcr_disease_treatment_mildiou" v="Svampemiddel" />
        <e k="rcr_disease_treatment_bcn" v="Nematicid" />
        <e k="rcr_fillType_fungicide" v="Svampemiddel" />
        <e k="rcr_fillType_nematicide" v="Nematicid" />
        <e k="rcr_disease_treatment_hernie" v="Ingen (resistent sort, kalkning, sædskifte)" />
        <e k="rcr_advice_pressure_high_phoma" v="Højt phoma-tryk — undgå raps og sennep i ca. 4 år, nedmuld planterester; efterårssvampemiddel på modtagelige sorter." />
        <e k="rcr_advice_pressure_high_pietin" v="Højt goldfodsyge-tryk — indsæt en ikke-værtsafgrøde som pause (havre, bælgplante, olieafgrøde); intet svampemiddel virker, kun sædskifte kurerer." />
        <e k="rcr_advice_pressure_high_septoriose" v="Højt septoria-tryk — undgå hvede/byg på kornrester, vælg en tolerant sort; svampemiddel fra strækning i et vådt klima." />
        <e k="rcr_advice_pressure_high_rouille" v="Højt rust-tryk — så en resistent sort og planlæg et svampemiddel; hold øje med milde fugtige perioder." />
        <e k="rcr_advice_pressure_high_fusariose" v="Højt fusarium-tryk — undgå hvede efter majs, nedmuld planterester; svampemiddel ved blomstring hvis vådt." />
        <e k="rcr_advice_pressure_high_mildiou" v="Højt kartoffelskimmel-tryk — plant en resistent sort og beskyt kartofler med svampemiddel, så snart det bliver køligt og vådt." />
        <e k="rcr_advice_pressure_high_hernie" v="Højt kålbrok-tryk — pause fra korsblomstrede i over 6 år, kalk for at hæve pH og så en resistent sort; ingen kemisk behandling." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Moderat phoma-tryk — forlæng pausen fra raps og snit stubben." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Moderat goldfodsyge-tryk — undgå et tredje korn i træk." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Moderat septoria-tryk — hold øje med forårsregn og smittekilder i planterester." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Moderat rust-tryk — spejd efter pustler i mildt vejr." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Moderat fusarium-tryk — spred korn og majs, håndter planterester." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Moderat kartoffelskimmel-tryk — overvåg køligt vådt vejr og fjern spildplanter." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Moderat kålbrok-tryk — forlæng pausen fra raps og hold øje med sur pH." />
