        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Setelah serealia, tanam legum untuk mengembalikan nitrogen atau tanaman jeda melawan penyakit pangkal batang, dan beri jarak dua tahun antar serealia." />
        <e k="rcr_advice_afterLegume" v="Setelah legum, serealia paling baik memanfaatkan nitrogen yang ditinggalkan, dan legum berikutnya harus menunggu tiga tahun." />
        <e k="rcr_advice_afterOilseed" v="Setelah tanaman minyak, beri jarak tiga tahun sebelum tanaman minyak mana pun kembali, dengan serealia lalu legum sebagai urutan ideal." />
        <e k="rcr_advice_afterRoot" v="Setelah tanaman umbi, tunggu empat tahun sebelum umbi kembali, lalu serealia untuk membangun kembali struktur setelah pemanenan akhir." />
        <e k="rcr_advice_afterVegetable" v="Setelah sayuran, tunggu tiga tahun sebelum mengulanginya, dengan serealia sebagai jeda yang bersih." />
        <e k="rcr_advice_afterForage" v="Setelah padang rumput sementara, serealia memanfaatkan kesuburan dan struktur yang terbentuk di bawah rumput." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Tekanan sclerotinia tinggi: jika kanola, sesawi, bunga matahari, kedelai, kacang polong, buncis, kentang, atau wortel kembali dalam 3 tahun, tekanan tetap tinggi; fungisida memperlambat munculnya penyakit dan membekukan kerusakan di bagian yang disemprot, tetapi tidak menyurutkan penyakit." />
        <e k="rcr_advice_pressure_high_bcn"           v="Tekanan nematoda tinggi: jika bit gula, bit merah, kanola, sesawi, atau bayam kembali dalam 3 tahun, tekanan tetap tinggi; nematisida menyelamatkan hasil di bagian yang disemprot selama 3 bulan." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Tekanan sclerotinia sedang: beri jarak tanaman inang, hujan menaikkan risiko." />
        <e k="rcr_advice_pressure_moderate_bcn"         v="Tekanan nematoda sedang: beri jarak bit dan brassica." />
        <e k="rcr_advice_no_current_crop" v="Tidak ada tanaman utama saat ini: saran tersedia saat tanaman terdeteksi." />

