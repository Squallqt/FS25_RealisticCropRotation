        <e k="rcr_disease_name_hernie" v="Klumprot" />
        <e k="rcr_disease_desc_sclerotinia" v="Hvitråte i oljevekster, belgvekster og rotvekster ved blomstring; sklerotier overlever i jorda i årevis, begunstiget av en fuktig blomstring." />
        <e k="rcr_disease_desc_phoma" v="Rothalsråte i raps/sennep som spres med planterester; krever et langt opphold fra oljevekster, forverres av høstfuktighet." />
        <e k="rcr_disease_desc_pietin" v="Rotdreper i sammenhengende korndyrking; brytes bare av en ikke-vertsvekst (havre, belgvekst, oljevekst). Ingen effektiv soppmiddel." />
        <e k="rcr_disease_desc_septoriose" v="Viktigste bladsykdom i hvete/bygg, spres med regnsprut fra planterester; eksplosiv i en våt vår." />
        <e k="rcr_disease_desc_rouille" v="Brunrust og gulrust i korn samt solsikke/raps; eksplosiv i mildt fuktig vær, spres med vinden." />
        <e k="rcr_disease_desc_fusariose" v="Aksfusariose begunstiget av korn- og maisrester (mais→hvete); kritisk ved en våt blomstring, skrumper kornet." />
        <e k="rcr_disease_desc_mildiou" v="Tørråte i potet; drevet av kjølig vått vær, lav avhengighet av vekstskifte; ødelegger åkeren på få dager." />
        <e k="rcr_disease_desc_bcn" v="Betecystenematode; cyster overlever i jorda i årevis, kronisk flekkvis stress; vekstskifte er den viktigste brekkstangen." />
        <e k="rcr_disease_desc_hernie" v="Klumprot; hvilesporer overlever i over seks år, krever et svært langt opphold fra korsblomstrede; ingen kjemisk behandling." />
        <e k="rcr_disease_treatment_sclerotinia" v="Soppmiddel" />
        <e k="rcr_disease_treatment_phoma" v="Soppmiddel" />
        <e k="rcr_disease_treatment_pietin" v="Ingen (vekstskifte)" />
        <e k="rcr_disease_treatment_septoriose" v="Soppmiddel" />
        <e k="rcr_disease_treatment_rouille" v="Soppmiddel" />
        <e k="rcr_disease_treatment_fusariose" v="Soppmiddel" />
        <e k="rcr_disease_treatment_mildiou" v="Soppmiddel" />
        <e k="rcr_disease_treatment_bcn" v="Nematicid" />
        <e k="rcr_fillType_fungicide" v="Soppmiddel" />
        <e k="rcr_fillType_nematicide" v="Nematicid" />
        <e k="rcr_disease_treatment_hernie" v="Ingen (resistent sort, kalking, vekstskifte)" />
        <e k="rcr_advice_pressure_high_phoma" v="Høyt phoma-trykk — unngå raps og sennep i ca. 4 år, mold ned planterester; soppmiddel om høsten på mottakelige sorter." />
        <e k="rcr_advice_pressure_high_pietin" v="Høyt rotdreper-trykk — sett inn en ikke-vertsvekst som opphold (havre, belgvekst, oljevekst); ingen soppmiddel virker, bare vekstskifte kurerer." />
        <e k="rcr_advice_pressure_high_septoriose" v="Høyt septoria-trykk — unngå hvete/bygg på kornrester, velg en tolerant sort; soppmiddel fra stråstrekking i et vått klima." />
        <e k="rcr_advice_pressure_high_rouille" v="Høyt rust-trykk — så en resistent sort og planlegg et soppmiddel; følg med på milde fuktige perioder." />
        <e k="rcr_advice_pressure_high_fusariose" v="Høyt fusarium-trykk — unngå hvete etter mais, mold ned planterester; soppmiddel ved blomstring hvis vått." />
        <e k="rcr_advice_pressure_high_mildiou" v="Høyt tørråte-trykk — plant en resistent sort og beskytt poteter med soppmiddel så snart det blir kjølig og vått." />
        <e k="rcr_advice_pressure_high_hernie" v="Høyt klumprot-trykk — opphold fra korsblomstrede i over 6 år, kalk for å heve pH og så en resistent sort; ingen kjemisk behandling." />
        <e k="rcr_advice_pressure_moderate_phoma" v="Moderat phoma-trykk — forleng oppholdet fra raps og kutt opp stubben." />
        <e k="rcr_advice_pressure_moderate_pietin" v="Moderat rotdreper-trykk — unngå et tredje korn på rad." />
        <e k="rcr_advice_pressure_moderate_septoriose" v="Moderat septoria-trykk — følg med på vårregn og smitte i planterester." />
        <e k="rcr_advice_pressure_moderate_rouille" v="Moderat rust-trykk — se etter pustler i mildt vær." />
        <e k="rcr_advice_pressure_moderate_fusariose" v="Moderat fusarium-trykk — spre korn og mais, håndter planterester." />
        <e k="rcr_advice_pressure_moderate_mildiou" v="Moderat tørråte-trykk — overvåk kjølig vått vær og fjern spillplanter." />
        <e k="rcr_advice_pressure_moderate_hernie" v="Moderat klumprot-trykk — forleng oppholdet fra raps og følg med på sur pH." />
