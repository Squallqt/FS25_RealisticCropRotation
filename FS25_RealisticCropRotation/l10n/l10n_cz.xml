        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="Po obilnině zasej luskovinu pro doplnění dusíku nebo přerušovací plodinu proti chorobám pat stébel a ponech dva roky mezi obilninami." />
        <e k="rcr_advice_afterLegume" v="Po luskovině obilnina nejlépe využije zanechaný dusík a další luskovina by měla počkat tři roky." />
        <e k="rcr_advice_afterOilseed" v="Po olejnině ponech tři roky před návratem jakékoli olejniny, s obilninou a poté luskovinou jako ideální posloupností." />
        <e k="rcr_advice_afterRoot" v="Po okopanině počkej čtyři roky, než se okopaniny vrátí, a poté obilninu pro obnovení struktury po pozdní sklizni." />
        <e k="rcr_advice_afterVegetable" v="Po zelenině počkej tři roky, než ji zopakuješ, s obilninou jako čistým přerušením." />
        <e k="rcr_advice_afterForage" v="Po dočasném travním porostu obilnina zhodnotí úrodnost a strukturu nahromaděnou pod drnem." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Vysoký tlak sklerotinie: pokud se řepka, hořčice, slunečnice, sója, hrách, fazol, brambory nebo mrkev vrátí do 3 let, tlak zůstává vysoký; fungicid zpomaluje nástup a zmrazuje škody na ošetřených plochách, chorobu ale nezatlačí." />
        <e k="rcr_advice_pressure_high_bcn"           v="Vysoký tlak háďátka: pokud se cukrovka, červená řepa, řepka, hořčice nebo špenát vrátí do 3 let, tlak zůstává vysoký; nematicid zachrání sklizeň na ošetřených plochách po dobu 3 měsíců." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Střední tlak sklerotinie: proložte hostitelské plodiny, déšť zvyšuje riziko." />
        <e k="rcr_advice_pressure_moderate_bcn"         v="Střední tlak háďátka: proložte řepu a brukvovité." />
        <e k="rcr_advice_no_current_crop" v="Žádná aktuální hlavní plodina: rada dostupná po detekci plodiny." />

