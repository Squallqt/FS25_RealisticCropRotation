        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="После зерновой культуры посейте бобовую для возврата азота или разрывную культуру против прикорневых болезней и выдержите два года между зерновыми." />
        <e k="rcr_advice_afterLegume" v="После бобовой культуры зерновая лучше всего использует оставленный азот, а следующая бобовая должна подождать три года." />
        <e k="rcr_advice_afterOilseed" v="После масличной культуры выдержите три года до любого возврата масличной, с зерновой, а затем бобовой как идеальной последовательностью." />
        <e k="rcr_advice_afterRoot" v="После корнеплода выждите четыре года до возврата корнеплодов, затем зерновую для восстановления структуры после поздней уборки." />
        <e k="rcr_advice_afterVegetable" v="После овоща подождите три года перед его повторением, с зерновой как чистым перерывом." />
        <e k="rcr_advice_afterForage" v="После временного травостоя зерновая использует плодородие и структуру, накопленные под дерниной." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Высокое давление склеротиниоза: не менее 3 лет избегайте рапса, подсолнечника, сои, гороха, фасоли, картофеля и моркови; фунгицид в период цветения при влажной погоде." />
        <e k="rcr_advice_pressure_high_bcn"           v="Высокое давление нематоды: 3 года избегайте сахарной свёклы, столовой свёклы, рапса, горчицы и шпината; нематицид или устойчивая культура-ловушка." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Умеренное давление склеротиниоза: разредите культуры-хозяева и следите за влажным цветением." />
