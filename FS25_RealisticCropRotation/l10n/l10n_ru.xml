        <!-- Agronomic advice -->
        <e k="rcr_advice_afterCereal" v="После зерновой культуры посейте бобовую для возврата азота или разрывную культуру против прикорневых болезней и выдержите два года между зерновыми." />
        <e k="rcr_advice_afterLegume" v="После бобовой культуры зерновая лучше всего использует оставленный азот, а следующая бобовая должна подождать три года." />
        <e k="rcr_advice_afterOilseed" v="После масличной культуры выдержите три года до любого возврата масличной, с зерновой, а затем бобовой как идеальной последовательностью." />
        <e k="rcr_advice_afterRoot" v="После корнеплода выждите четыре года до возврата корнеплодов, затем зерновую для восстановления структуры после поздней уборки." />
        <e k="rcr_advice_afterVegetable" v="После овоща подождите три года перед его повторением, с зерновой как чистым перерывом." />
        <e k="rcr_advice_afterForage" v="После временного травостоя зерновая использует плодородие и структуру, накопленные под дерниной." />
        <e k="rcr_advice_disease_sclerotinia" v="Эта культура является хозяином склеротиниоза, поэтому выдерживайте не менее трёх лет от рапса, подсолнечника, сои, гороха и фасоли." />
        <e k="rcr_advice_disease_bcn" v="Эта культура является хозяином свекловичной цистообразующей нематоды, поэтому держите свёклу и крестоцветные подальше друг от друга." />
        <e k="rcr_advice_pressure_high_sclerotinia"   v="Высокое давление склеротиниоза на этом поле — избегайте рапс, подсолнечник, сою, горох и фасоль как минимум три года." />
        <e k="rcr_advice_pressure_high_bcn"           v="Высокое давление свекловичной цистообразующей нематоды на этом поле — избегайте сахарную свёклу, столовую свёклу, рапс, горчицу и шпинат как минимум три года." />
        <e k="rcr_advice_pressure_moderate_sclerotinia" v="Умеренное давление склеротиниоза на этом поле — тщательно планируйте чередование культур-хозяев." />
        <e k="rcr_advice_pressure_moderate_bcn"         v="Умеренное давление свекловичной цистообразующей нематоды на этом поле — тщательно планируйте чередование свёклы и крестоцветных." />
